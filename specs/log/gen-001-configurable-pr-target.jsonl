{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MMih5iqNXvkAgvRPUZsYMG","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Command github-update-go-agent consumes github-update-go tasks and lands a\n6\t// reviewable draft PR bringing a Go repo to the current toolchain +\n7\t// dependencies with a green repo gate (design docs/design.md).\n8\t//\n9\t// This binary is the Kafka entry point — spawned as a K8s Job by\n10\t// task/executor with TASK_CONTENT + TASK_ID + PHASE + KAFKA_BROKERS env.\n11\t// For local CLI mode (file-based), see cmd/run-task/main.go.\n12\tpackage main\n13\t\n14\timport (\n15\t\t\"context\"\n16\t\t\"os\"\n17\t\t\"time\"\n18\t\n19\t\tagentlib \"github.com/bborbe/agent\"\n20\t\tclaudelib \"github.com/bborbe/agent/claude\"\n21\t\tdelivery \"github.com/bborbe/agent/delivery\"\n22\t\t\"github.com/bborbe/agent/envparse\"\n23\t\tlibmetrics \"github.com/bborbe/agent/metrics\"\n24\t\t\"github.com/bborbe/cqrs/base\"\n25\t\t\"github.com/bborbe/errors\"\n26\t\tlibkafka \"github.com/bborbe/kafka\"\n27\t\tlibsentry \"github.com/bborbe/sentry\"\n28\t\t\"github.com/bborbe/service\"\n29\t\tlibtime \"github.com/bborbe/time\"\n30\t\t\"github.com/bborbe/vault-cli/pkg/domain\"\n31\t\t\"github.com/golang/glog\"\n32\t\t\"github.com/prometheus/client_golang/prometheus\"\n33\t\t\"github.com/prometheus/client_golang/prometheus/push\"\n34\t\n35\t\tupdatepkg \"github.com/bborbe/github-update-go-agent/pkg\"\n36\t\t\"github.com/bborbe/github-update-go-agent/pkg/factory\"\n37\t\t\"github.com/bborbe/github-update-go-agent/pkg/githubauth\"\n38\t)\n39\t\n40\t// agentName is the identity string used for Prometheus metric grouping and logging.\n41\tconst agentName = \"github-update-go-agent\"\n42\t\n43\tfunc main() {\n44\t\tapp := &application{}\n45\t\tos.Exit(service.Main(context.Background(), app, &app.SentryDSN, &app.SentryProxy))\n46\t}\n47\t\n48\ttype application struct {\n49\t\tSentryDSN   string `required:\"false\" arg:\"sentry-dsn\"   env:\"SENTRY_DSN\"   usage:\"SentryDSN\"    display:\"length\"`\n50\t\tSentryProxy string `required:\"false\" arg:\"sentry-proxy\" env:\"SENTRY_PROXY\" usage:\"Sentry Proxy\" display:\"length\"`\n51\t\n52\t\t// Claude Code CLI configuration\n53\t\tClaudeConfigDir claudelib.ClaudeConfigDir `required:\"false\" arg:\"claude-config-dir\" env:\"CLAUDE_CONFIG_DIR\" usage:\"Claude Code config directory\"`\n54\t\n55\t\t// Agent directory (contains .claude/ with CLAUDE.md and commands)\n56\t\tAgentDir claudelib.AgentDir `required:\"false\" arg:\"agent-dir\" env:\"AGENT_DIR\" usage:\"Agent directory with .claude/ config\" default:\"agent\"`\n57\t\n58\t\t// Task content from agent pipeline\n59\t\tTaskContent string `required:\"true\" arg:\"task-content\" env:\"TASK_CONTENT\" usage:\"Raw task markdown from vault\"`\n60\t\n61\t\t// Environment variables passed to Claude CLI process (comma-separated KEY=VALUE pairs).\n62\t\t// Use this for ad-hoc / less-common env vars. The three load-bearing Anthropic provider\n63\t\t// vars below have dedicated arg slots so they don't have to be packed into this string.\n64\t\tClaudeEnvRaw string `required:\"false\" arg:\"claude-env\" env:\"CLAUDE_ENV\" usage:\"Comma-separated KEY=VALUE pairs for Claude CLI environment\"`\n65\t\n66\t\t// Anthropic-compatible provider routing. Setting AnthropicBaseURL + AnthropicAuthToken\n67\t\t// routes the claude CLI to an alt-provider. AnthropicModel drives both the `--model`\n68\t\t// CLI flag and the ANTHROPIC_MODEL env var seen by the claude subprocess.\n69\t\tAnthropicBaseURL   string                `required:\"false\" arg:\"anthropic-base-url\"   env:\"ANTHROPIC_BASE_URL\"   usage:\"Anthropic-compatible API base URL\"`\n70\t\tAnthropicAuthToken string                `required:\"false\" arg:\"anthropic-auth-token\" env:\"ANTHROPIC_AUTH_TOKEN\" usage:\"Bearer token for ANTHROPIC_BASE_URL\"                                  display:\"password\"`\n71\t\tAnthropicModel     claudelib.ClaudeModel `required:\"false\" arg:\"anthropic-model\"      env:\"ANTHROPIC_MODEL\"      usage:\"Model name; also exposed to the claude subprocess as ANTHROPIC_MODEL\"                    default:\"sonnet\"`\n72\t\n73\t\t// Branch for Kafka result delivery\n74\t\tBranch base.Branch `required:\"false\" arg:\"branch\" env:\"BRANCH\" usage:\"branch\"`\n75\t\n76\t\t// TopicPrefix is an explicit Kafka topic prefix, independent of Branch.\n77\t\tTopicPrefix base.TopicPrefix `required:\"false\" arg:\"topic-prefix\" env:\"TOPIC_PREFIX\" usage:\"Explicit Kafka topic prefix; empty means unprefixed topics\"`\n78\t\n79\t\t// Phase to run (framework requires explicit phase)\n80\t\tPhase domain.TaskPhase `required:\"false\" arg:\"phase\" env:\"PHASE\" usage:\"Agent phase: planning | execution | ai_review\" default:\"execution\"`\n81\t\n82\t\t// GitHub token for authenticated clones + gh CLI calls. Used as the raw\n83\t\t// fallback credential when GitHub App creds are absent (local\n84\t\t// cmd/run-task path where the operator exports `gh auth token`).\n85\t\tGhToken string `required:\"false\" arg:\"gh-token\" env:\"GH_TOKEN\" usage:\"GitHub token for clone + PR creation (raw fallback when App creds unset)\" display:\"length\"`\n86\t\n87\t\t// GitHub App authentication (design § 7.2). When APP_ID, INSTALLATION_ID,\n88\t\t// and a PEM (file or inline) are all set, the pod mints a short-lived\n89\t\t// installation access token at startup and forwards it to every git/gh\n90\t\t// subprocess as GH_TOKEN. The cluster pod sets these (GH_TOKEN is empty\n91\t\t// there); locally they are absent and the agent falls back to GhToken.\n92\t\tAppID          int64  `required:\"false\" arg:\"app-id\"          env:\"APP_ID\"          usage:\"GitHub App ID (numeric); enables App auth when set with INSTALLATION_ID + PEM\"`\n93\t\tInstallationID int64  `required:\"false\" arg:\"installation-id\" env:\"INSTALLATION_ID\" usage:\"GitHub App Installation ID (numeric)\"`\n94\t\tPEMKeyFile     string `required:\"false\" arg:\"pem-key-file\"    env:\"PEM_KEY_FILE\"    usage:\"Path to the GitHub App private key (PEM file mounted from k8s Secret)\"`\n95\t\tPEMKey         string `required:\"false\" arg:\"pem-key\"         env:\"PEM_KEY\"         usage:\"GitHub App private key (PEM) as env var content; mutually exclusive with PEM_KEY_FILE\" display:\"length\"`\n96\t\n97\t\t// Kafka delivery (optional — only active when TASK_ID is set)\n98\t\tKafkaBrokers libkafka.Brokers        `required:\"false\" arg:\"kafka-brokers\" env:\"KAFKA_BROKERS\" usage:\"Comma separated list of Kafka brokers\"`\n99\t\tTaskID       agentlib.TaskIdentifier `required:\"false\" arg:\"task-id\"       env:\"TASK_ID\"       usage:\"Agent task identifier for publishing results back to task controller\"`\n100\t\n101\t\tPushgatewayURL string `required:\"false\" arg:\"pushgateway-url\" env:\"PUSHGATEWAY_URL\" usage:\"Prometheus PushGateway URL\"          default:\"http://pushgateway:9090\"`\n102\t\tTaskType       string `required:\"false\" arg:\"task-type\"       env:\"TASK_TYPE\"       usage:\"Task type label for metric grouping\" default:\"unknown\"`\n103\t}\n104\t\n105\tfunc (a *application) Run(ctx context.Context, _ libsentry.Client) error {\n106\t\tregistry := prometheus.NewRegistry()\n107\t\tjobMetrics := libmetrics.NewJobMetrics(registry, libtime.NewCurrentDateTime())\n108\t\tpusher := push.New(a.PushgatewayURL, libmetrics.BuildJobMetricsName(agentName)).\n109\t\t\tGrouping(\"agent\", agentName).\n110\t\t\tGrouping(\"task_type\", a.TaskType).\n111\t\t\tCollector(registry)\n112\t\tdefer func() {\n113\t\t\tif err := pusher.PushContext(ctx); err != nil {\n114\t\t\t\tglog.Warningf(\"prometheus push failed: %v\", err)\n115\t\t\t\treturn\n116\t\t\t}\n117\t\t\tglog.V(2).Infof(\"prometheus push completed\")\n118\t\t}()\n119\t\tstart := libtime.NewCurrentDateTime().Now().Time()\n120\t\n121\t\tglog.V(2).Infof(\"github-update-go-agent started phase=%s\", a.Phase)\n122\t\n123\t\t// Resolve the GitHub credential (App IAT or raw GH_TOKEN fallback) and make\n124\t\t// it usable by every git/gh subprocess. See prepareAuth.\n125\t\tresolvedToken, err := a.prepareAuth(ctx)\n126\t\tif err != nil {\n127\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n128\t\t\tjobMetrics.RecordDuration(time.Since(start))\n129\t\t\treturn err\n130\t\t}\n131\t\n132\t\tdeliverer := delivery.NewNoopResultDeliverer()\n133\t\tif a.TaskID != \"\" {\n134\t\t\tif len(a.KafkaBrokers) == 0 {\n135\t\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n136\t\t\t\tjobMetrics.RecordDuration(time.Since(start))\n137\t\t\t\treturn errors.Errorf(ctx, \"KAFKA_BROKERS must be set when TASK_ID is set\")\n138\t\t\t}\n139\t\t\tsyncProducer, err := factory.CreateSyncProducer(ctx, a.KafkaBrokers)\n140\t\t\tif err != nil {\n141\t\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n142\t\t\t\tjobMetrics.RecordDuration(time.Since(start))\n143\t\t\t\treturn errors.Wrap(ctx, err, \"create sync producer\")\n144\t\t\t}\n145\t\t\tdefer func() {\n146\t\t\t\tif err := syncProducer.Close(); err != nil {\n147\t\t\t\t\tglog.Warningf(\"close sync producer failed: %v\", err)\n148\t\t\t\t}\n149\t\t\t}()\n150\t\t\tdeliverer = factory.CreateKafkaResultDeliverer(\n151\t\t\t\tsyncProducer, a.TopicPrefix, a.TaskID, a.TaskContent,\n152\t\t\t\tlibtime.NewCurrentDateTime(),\n153\t\t\t)\n154\t\t}\n155\t\n156\t\tclaudeEnv := a.buildClaudeEnv(resolvedToken)\n157\t\n158\t\tprovider := factory.CreateAgentProvider(\n159\t\t\ta.ClaudeConfigDir,\n160\t\t\ta.AgentDir,\n161\t\t\ta.AnthropicModel,\n162\t\t\tresolvedToken,\n163\t\t\tclaudeEnv,\n164\t\t\tfactory.CreateGitOps(),\n165\t\t\tfactory.CreateGhCli(resolvedToken),\n166\t\t\tfactory.CreateGateRunner(),\n167\t\t\tfactory.CreateClaudeProber(a.ClaudeConfigDir),\n168\t\t)\n169\t\tagent, err := provider.Get(ctx, agentlib.TaskType(a.TaskType))\n170\t\tif err != nil {\n171\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n172\t\t\tjobMetrics.RecordDuration(time.Since(start))\n173\t\t\treturn errors.Wrap(ctx, err, \"select agent for task_type\")\n174\t\t}\n175\t\n176\t\tresult, err := agent.Run(ctx, a.Phase, a.TaskContent, deliverer)\n177\t\tif err != nil {\n178\t\t\tjobMetrics.RecordRun(agentlib.AgentStatusFailed)\n179\t\t\tjobMetrics.RecordDuration(time.Since(start))\n180\t\t\treturn errors.Wrap(ctx, err, \"agent run failed\")\n181\t\t}\n182\t\tjobMetrics.RecordRun(result.Status)\n183\t\tjobMetrics.RecordDuration(time.Since(start))\n184\t\treturn agentlib.PrintResult(ctx, result)\n185\t}\n186\t\n187\t// buildClaudeEnv assembles the Claude CLI subprocess env from the raw env\n188\t// pairs plus the Anthropic provider-routing overrides. resolvedToken, when\n189\t// non-empty, is threaded in as GH_TOKEN — the ClaudeRunner strips pod env to\n190\t// an allowlist, so the token must be passed explicitly (os.Setenv in\n191\t// prepareAuth covers other subprocess paths, not the Claude runner).\n192\tfunc (a *application) buildClaudeEnv(resolvedToken string) map[string]string {\n193\t\tclaudeEnv := envparse.KeyValuePairs(a.ClaudeEnvRaw)\n194\t\tif claudeEnv == nil {\n195\t\t\tclaudeEnv = map[string]string{}\n196\t\t}\n197\t\tfor k, v := range updatepkg.BuildEnv(\n198\t\t\tresolvedToken,\n199\t\t\ta.AnthropicBaseURL,\n200\t\t\ta.AnthropicAuthToken,\n201\t\t\ta.AnthropicModel.String(),\n202\t\t) {\n203\t\t\tclaudeEnv[k] = v\n204\t\t}\n205\t\treturn claudeEnv\n206\t}\n207\t\n208\t// prepareAuth resolves the GitHub credential and makes it usable by every\n209\t// git/gh subprocess: it exports GH_TOKEN (covering the repo gate targets,\n210\t// which inherit os.Environ() for their module fetches) and installs git's\n211\t// credential helper via `gh auth setup-git`. Returns the resolved token for\n212\t// the GitOps URL injection / gh CLI seam / gh-token preflight wiring.\n213\tfunc (a *application) prepareAuth(ctx context.Context) (string, error) {\n214\t\tresolvedToken, err := a.resolveAuth(ctx)\n215\t\tif err != nil {\n216\t\t\treturn \"\", err\n217\t\t}\n218\t\t// resolvedToken is always non-empty here (resolveAuth errors otherwise), but\n219\t\t// guard defensively — an empty GH_TOKEN would mislead the gate subprocesses.\n220\t\tif resolvedToken != \"\" {\n221\t\t\tif err := os.Setenv(\"GH_TOKEN\", resolvedToken); err != nil {\n222\t\t\t\treturn \"\", errors.Wrap(ctx, err, \"export GH_TOKEN\")\n223\t\t\t}\n224\t\t}\n225\t\tif err := githubauth.NewGhAuthSetupGit(resolvedToken).Setup(ctx); err != nil {\n226\t\t\treturn \"\", errors.Wrap(ctx, err, \"gh auth setup-git\")\n227\t\t}\n228\t\treturn resolvedToken, nil\n229\t}\n230\t\n231\t// resolveAuth resolves the GitHub credential forwarded to every git/gh\n232\t// subprocess. It prefers GitHub App authentication: when APP_ID,\n233\t// INSTALLATION_ID, and a PEM (file or inline) are all set, it mints a\n234\t// short-lived installation access token via githubauth.Resolve. Otherwise it\n235\t// falls back to the raw GH_TOKEN input — the local cmd/run-task path where\n236\t// the operator exports `gh auth token`. When neither is configured it\n237\t// returns a clear error, since the agent cannot clone or push without a\n238\t// credential.\n239\tfunc (a *application) resolveAuth(ctx context.Context) (string, error) {\n240\t\tmode := githubauth.ResolveAuthMode(a.AppID, a.InstallationID, a.PEMKeyFile, a.PEMKey)\n241\t\tif mode == githubauth.AuthModeGitHubApp {\n242\t\t\t// Startup auth must not be killed by the task's work deadline: mint on a\n243\t\t\t// fresh bounded context (keeps ctx values, drops the caller's\n244\t\t\t// deadline/cancel) so a near-deadline task can't fail the token mint.\n245\t\t\tmintCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)\n246\t\t\tdefer cancel()\n247\t\t\tiat, err := githubauth.Resolve(mintCtx, githubauth.Config{\n248\t\t\t\tAppID:          a.AppID,\n249\t\t\t\tInstallationID: a.InstallationID,\n250\t\t\t\tPEMKeyFile:     a.PEMKeyFile,\n251\t\t\t\tPEMKey:         a.PEMKey,\n252\t\t\t})\n253\t\t\tif err != nil {\n254\t\t\t\treturn \"\", errors.Wrap(ctx, err, \"resolve github app auth\")\n255\t\t\t}\n256\t\t\tglog.V(2).Infof(\n257\t\t\t\t\"github-update-go-agent auth mode=github-app app_id=%d installation_id=%d\",\n258\t\t\t\ta.AppID, a.InstallationID,\n259\t\t\t)\n260\t\t\treturn iat, nil\n261\t\t}\n262\t\tif a.GhToken != \"\" {\n263\t\t\tglog.V(2).Infof(\"github-update-go-agent auth mode=gh-token (raw GH_TOKEN fallback)\")\n264\t\t\treturn a.GhToken, nil\n265\t\t}\n266\t\treturn \"\", errors.Errorf(\n267\t\t\tctx,\n268\t\t\t\"github-update-go-agent auth: no credentials configured — set GitHub App creds (APP_ID, INSTALLATION_ID, PEM_KEY_FILE or PEM_KEY) or GH_TOKEN\",\n269\t\t)\n270\t}\n271\t"}]},"parent_tool_use_id":"call_f957bd7b98874acf90e3a141","session_id":"698f096f-a0f8-4a78-ad91-b84cbf89d0ae","uuid":"bcfff570-ace8-46dd-bc18-16a78521d888","timestamp":"2026-08-14T23:24:11.255Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec"}
