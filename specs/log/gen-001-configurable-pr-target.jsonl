{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bc9WV51QaUvXtnCHr4oZeQ","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\t// ReviewChecks holds the boolean verification results of the pure-Go\n8\t// ai_review step. Every field is derived from independent re-execution —\n9\t// never copied from ## Result (design § 4.4).\n10\ttype ReviewChecks struct {\n11\t\t// PROpen — `gh pr view` reports state OPEN.\n12\t\tPROpen bool `json:\"pr_open\"`\n13\t\t// PRDraft — `gh pr view` reports isDraft true (the agent never readies).\n14\t\tPRDraft bool `json:\"pr_draft\"`\n15\t\t// GateGreen — every planned gate target re-ran to exit 0 on a fresh\n16\t\t// worktree at the branch.\n17\t\tGateGreen bool `json:\"gate_green\"`\n18\t\t// VulnsClear — the scanner-bearing gate targets came back green on the\n19\t\t// re-run (the gate IS the vuln verdict, per design § 7.3 the repo's\n20\t\t// gate wraps govulncheck/osv-scanner/trivy).\n21\t\tVulnsClear bool `json:\"vulns_clear\"`\n22\t\t// ChangelogUnreleased — CHANGELOG.md carries a bullet under\n23\t\t// ## Unreleased and introduces no new version header vs master.\n24\t\tChangelogUnreleased bool `json:\"changelog_unreleased\"`\n25\t\t// NoNewTag — `git ls-remote --tags` shows no tag pointing at any\n26\t\t// branch commit.\n27\t\tNoNewTag bool `json:\"no_new_tag\"`\n28\t}\n29\t\n30\t// ReviewOutput is the typed contract for the `## Review` JSON section the\n31\t// ai_review step writes. Round-trips with agentlib.MarshalSectionTyped +\n32\t// agentlib.ExtractSection[ReviewOutput].\n33\ttype ReviewOutput struct {\n34\t\tApproved bool         `json:\"approved\"`\n35\t\tChecks   ReviewChecks `json:\"checks\"`\n36\t\tNotes    string       `json:\"notes\"`\n37\t}\n38\t"}]},"parent_tool_use_id":"call_f957bd7b98874acf90e3a141","session_id":"698f096f-a0f8-4a78-ad91-b84cbf89d0ae","uuid":"dc7d65d3-a750-4e77-92b0-fa2132a53a0c","timestamp":"2026-08-14T23:24:13.980Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec"}
