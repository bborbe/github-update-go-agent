{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UHvqv8PrhAfCJn1RxKBx3v","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"regexp\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\tagentlib \"github.com/bborbe/agent\"\n16\t\t\"github.com/bborbe/errors\"\n17\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n18\t\t\"github.com/golang/glog\"\n19\t\n20\t\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n21\t)\n22\t\n23\t// changelogFileName is the changelog the review verifies.\n24\tconst changelogFileName = \"CHANGELOG.md\"\n25\t\n26\t// versionHeaderRegexp matches released version headers (## v1.2.3 / ## 1.2.3).\n27\tvar versionHeaderRegexp = regexp.MustCompile(`(?m)^## v?\\d+\\.\\d+\\.\\d+`)\n28\t\n29\t// reviewStep implements agentlib.Step for the ai_review phase — a PURE-GO\n30\t// verifier (design D1): every check is derived from independent re-execution\n31\t// on a fresh worktree, never copied from ## Result, and a non-LLM verifier\n32\t// cannot rubber-stamp.\n33\ttype reviewStep struct {\n34\t\tops     git.GitOps\n35\t\tgh      GhCli\n36\t\tgate    GateRunner\n37\t\tghToken string\n38\t}\n39\t\n40\t// NewReviewStep wires the ai_review verifier with its GitOps seam (fresh\n41\t// clone + tag/rev inspection), gh CLI seam (PR state), gate runner\n42\t// (independent gate re-run), and the GitHub token.\n43\tfunc NewReviewStep(\n44\t\tops git.GitOps,\n45\t\tgh GhCli,\n46\t\tgate GateRunner,\n47\t\tghToken string,\n48\t) agentlib.Step {\n49\t\treturn &reviewStep{ops: ops, gh: gh, gate: gate, ghToken: ghToken}\n50\t}\n51\t\n52\t// Name implements agentlib.Step.\n53\tfunc (s *reviewStep) Name() string { return \"github-update-go-review\" }\n54\t\n55\t// ShouldRun always returns true — a re-trigger overwrites ## Review.\n56\tfunc (s *reviewStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n57\t\treturn true, nil\n58\t}\n59\t\n60\t// Run executes the verification pipeline (design § 4.3 ai_review):\n61\t//  1. Read ## Plan + ## Result (fatal error if either missing).\n62\t//  2. pr_open + pr_draft — `gh pr view` must report OPEN + draft.\n63\t//  3. Fresh worktree at the branch; re-run every planned gate target → exit 0\n64\t//     (gate_green; vulns_clear — the gate wraps the scanners).\n65\t//  4. changelog_unreleased — CHANGELOG has an ## Unreleased bullet and no\n66\t//     new version header vs master.\n67\t//  5. no_new_tag — `git ls-remote --tags` shows no tag at any branch commit.\n68\t//  6. All true → ## Review approved + Done/NextPhase human_review (the ONLY\n69\t//     writer of that phase; success semantics per doctrine).\n70\t//     Any false → ## Review approved:false + Status Failed, NO NextPhase.\n71\tfunc (s *reviewStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n72\t\tresult, err := agentlib.ExtractSection[ResultOutput](ctx, md, \"## Result\")\n73\t\tif err != nil || result == nil {\n74\t\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Result section\")\n75\t\t}\n76\t\tplan, err := agentlib.ExtractSection[PlanOutput](ctx, md, \"## Plan\")\n77\t\tif err != nil || plan == nil {\n78\t\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Plan section\")\n79\t\t}\n80\t\n81\t\tvar notes []string\n82\t\tif result.PRURL == \"\" || result.Branch == \"\" {\n83\t\t\treturn s.finish(ctx, md, ReviewOutput{\n84\t\t\t\tApproved: false,\n85\t\t\t\tNotes:    \"## Result carries no pr_url/branch — nothing to verify\",\n86\t\t\t})\n87\t\t}\n88\t\n89\t\tchecks := ReviewChecks{}\n90\t\ts.checkPR(ctx, result, &checks, &notes)\n91\t\n92\t\tcloneURL, _ := md.Frontmatter.String(\"clone_url\")\n93\t\tref, _ := md.Frontmatter.String(\"ref\")\n94\t\trepo, _ := md.Frontmatter.String(\"repo\")\n95\t\tauthedURL := injectToken(normalizeCloneURLToHTTPS(cloneURL), s.ghToken)\n96\t\n97\t\tworkdir := setupWorkdir(md, repo)\n98\t\tdefer func() {\n99\t\t\tif err := os.RemoveAll(workdir); err != nil {\n100\t\t\t\tglog.Warningf(\"ai_review: workdir cleanup failed: path=%s err=%v\", workdir, err)\n101\t\t\t}\n102\t\t}()\n103\t\n104\t\tif err := s.ops.CloneAtRef(ctx, authedURL, result.Branch, workdir); err != nil {\n105\t\t\t// Fail closed: without the fresh worktree no local check can pass.\n106\t\t\tnotes = append(notes, \"fresh worktree clone failed: \"+git.RedactToken(err.Error()))\n107\t\t} else {\n108\t\t\ts.checkGates(ctx, workdir, plan, &checks, &notes)\n109\t\t\ts.checkChangelog(ctx, workdir, &checks, &notes)\n110\t\t\ts.checkNoNewTag(ctx, workdir, authedURL, ref, &checks, &notes)\n111\t\t}\n112\t\n113\t\tapproved := checks.PROpen && checks.PRDraft && checks.GateGreen &&\n114\t\t\tchecks.VulnsClear && checks.ChangelogUnreleased && checks.NoNewTag\n115\t\toutput := ReviewOutput{\n116\t\t\tApproved: approved,\n117\t\t\tChecks:   checks,\n118\t\t\tNotes:    notesFor(notes),\n119\t\t}\n120\t\treturn s.finish(ctx, md, output)\n121\t}\n122\t\n123\t// finish writes ## Review and maps approved → Done/human_review,\n124\t// rejected → Failed with NO NextPhase (the controller parks; human_review\n125\t// is reserved for end-of-pipeline success).\n126\tfunc (s *reviewStep) finish(\n127\t\tctx context.Context,\n128\t\tmd *agentlib.Markdown,\n129\t\toutput ReviewOutput,\n130\t) (*agentlib.Result, error) {\n131\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Review\", output)\n132\t\tif err != nil {\n133\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Review section\")\n134\t\t}\n135\t\tmd.ReplaceSection(section)\n136\t\n137\t\tif output.Approved {\n138\t\t\tglog.V(2).Infof(\"ai_review: approved — routing human_review\")\n139\t\t\treturn &agentlib.Result{\n140\t\t\t\tStatus:    agentlib.AgentStatusDone,\n141\t\t\t\tNextPhase: domain.TaskPhaseHumanReview.String(),\n142\t\t\t}, nil\n143\t\t}\n144\t\tglog.V(2).Infof(\"ai_review: rejected — %s\", output.Notes)\n145\t\treturn &agentlib.Result{\n146\t\t\tStatus:  agentlib.AgentStatusFailed,\n147\t\t\tMessage: output.Notes,\n148\t\t}, nil\n149\t}\n150\t\n151\t// checkPR verifies the PR is OPEN and still a draft (the agent never\n152\t// readies; a non-draft here means someone else flipped it — surfaced for\n153\t// the operator, and per the check contract the review fails closed).\n154\tfunc (s *reviewStep) checkPR(\n155\t\tctx context.Context,\n156\t\tresult *ResultOutput,\n157\t\tchecks *ReviewChecks,\n158\t\tnotes *[]string,\n159\t) {\n160\t\tstate, isDraft, err := s.gh.ViewPR(ctx, result.PRURL)\n161\t\tif err != nil {\n162\t\t\t*notes = append(*notes, \"gh pr view failed: \"+err.Error())\n163\t\t\treturn\n164\t\t}\n165\t\tchecks.PROpen = state == \"OPEN\"\n166\t\tchecks.PRDraft = isDraft\n167\t\tif !checks.PROpen {\n168\t\t\t*notes = append(*notes, \"pr state is \"+state+\", expected OPEN\")\n169\t\t}\n170\t\tif !checks.PRDraft {\n171\t\t\t*notes = append(*notes, \"pr is not a draft\")\n172\t\t}\n173\t}\n174\t\n175\t// checkGates independently re-runs every planned gate target on the fresh\n176\t// worktree. gate_green is derived from THIS re-execution, never from\n177\t// Result.gate_exit (design § 4.4). vulns_clear rides the same run — the\n178\t// repo's gate targets wrap the scanners (design § 7.3).\n179\tfunc (s *reviewStep) checkGates(\n180\t\tctx context.Context,\n181\t\tworkdir string,\n182\t\tplan *PlanOutput,\n183\t\tchecks *ReviewChecks,\n184\t\tnotes *[]string,\n185\t) {\n186\t\tif len(plan.GateTargets) == 0 {\n187\t\t\t*notes = append(*notes, \"plan carries no gate_targets\")\n188\t\t\treturn\n189\t\t}\n190\t\tfor _, target := range plan.GateTargets {\n191\t\t\ttail, exitCode, err := s.gate.RunTarget(ctx, workdir, target)\n192\t\t\tif err != nil {\n193\t\t\t\t*notes = append(*notes, \"gate target \"+target+\" red (exit \"+\n194\t\t\t\t\tstrconv.Itoa(exitCode)+\"): \"+tail)\n195\t\t\t\treturn\n196\t\t\t}\n197\t\t}\n198\t\tchecks.GateGreen = true\n199\t\tchecks.VulnsClear = true\n200\t}\n201\t\n202\t// checkChangelog verifies CHANGELOG.md on the branch carries at least one\n203\t// bullet under ## Unreleased and introduces NO new version header compared\n204\t// to origin/master (the release agent finalizes versions on merge — a new\n205\t// header here means the update finalized a version, which is forbidden).\n206\tfunc (s *reviewStep) checkChangelog(\n207\t\tctx context.Context,\n208\t\tworkdir string,\n209\t\tchecks *ReviewChecks,\n210\t\tnotes *[]string,\n211\t) {\n212\t\tbranchContent, err := os.ReadFile(\n213\t\t\tfilepath.Join(workdir, changelogFileName),\n214\t\t) // #nosec G304 -- workdir is os.TempDir-rooted; filename is constant\n215\t\tif err != nil {\n216\t\t\t*notes = append(*notes, \"read CHANGELOG.md failed: \"+err.Error())\n217\t\t\treturn\n218\t\t}\n219\t\tif !hasUnreleasedBullet(string(branchContent)) {\n220\t\t\t*notes = append(*notes, \"CHANGELOG has no bullet under ## Unreleased\")\n221\t\t\treturn\n222\t\t}\n223\t\tmasterContent, err := s.ops.ShowFile(ctx, workdir, \"origin/master\", changelogFileName)\n224\t\tif err != nil {\n225\t\t\t*notes = append(*notes, \"read master CHANGELOG failed: \"+err.Error())\n226\t\t\treturn\n227\t\t}\n228\t\tmasterHeaders := map[string]struct{}{}\n229\t\tfor _, h := range versionHeaderRegexp.FindAllString(string(masterContent), -1) {\n230\t\t\tmasterHeaders[h] = struct{}{}\n231\t\t}\n232\t\tfor _, h := range versionHeaderRegexp.FindAllString(string(branchContent), -1) {\n233\t\t\tif _, ok := masterHeaders[h]; !ok {\n234\t\t\t\t*notes = append(*notes, \"CHANGELOG introduces new version header \"+h+\n235\t\t\t\t\t\" — versioning is the release agent's job on merge\")\n236\t\t\t\treturn\n237\t\t\t}\n238\t\t}\n239\t\tchecks.ChangelogUnreleased = true\n240\t}\n241\t\n242\t// checkNoNewTag verifies the remote holds no tag pointing at any branch\n243\t// commit (git ls-remote --tags unchanged with respect to the branch work).\n244\tfunc (s *reviewStep) checkNoNewTag(\n245\t\tctx context.Context,\n246\t\tworkdir, authedURL, ref string,\n247\t\tchecks *ReviewChecks,\n248\t\tnotes *[]string,\n249\t) {\n250\t\tif ref == \"\" {\n251\t\t\t*notes = append(*notes, \"frontmatter ref missing — cannot compute branch commits\")\n252\t\t\treturn\n253\t\t}\n254\t\tbranchCommits, err := s.ops.RevList(ctx, workdir, ref)\n255\t\tif err != nil {\n256\t\t\t*notes = append(*notes, \"rev-list failed: \"+err.Error())\n257\t\t\treturn\n258\t\t}\n259\t\ttagSHAs, err := s.ops.LsRemoteTags(ctx, authedURL)\n260\t\tif err != nil {\n261\t\t\t*notes = append(*notes, \"ls-remote --tags failed: \"+git.RedactToken(err.Error()))\n262\t\t\treturn\n263\t\t}\n264\t\tcommitSet := map[string]struct{}{}\n265\t\tfor _, sha := range branchCommits {\n266\t\t\tcommitSet[sha] = struct{}{}\n267\t\t}\n268\t\tfor _, sha := range tagSHAs {\n269\t\t\tif _, ok := commitSet[sha]; ok {\n270\t\t\t\t*notes = append(*notes, \"remote tag points at branch commit \"+sha+\n271\t\t\t\t\t\" — a tag leaked from the update pipeline\")\n272\t\t\t\treturn\n273\t\t\t}\n274\t\t}\n275\t\tchecks.NoNewTag = true\n276\t}\n277\t\n278\t// hasUnreleasedBullet reports whether the ## Unreleased section contains at\n279\t// least one markdown bullet before the next ## heading.\n280\tfunc hasUnreleasedBullet(content string) bool {\n281\t\tidx := strings.Index(content, \"## Unreleased\")\n282\t\tif idx < 0 {\n283\t\t\treturn false\n284\t\t}\n285\t\tbody := content[idx+len(\"## Unreleased\"):]\n286\t\tif next := strings.Index(body, \"\\n## \"); next >= 0 {\n287\t\t\tbody = body[:next]\n288\t\t}\n289\t\tfor _, line := range strings.Split(body, \"\\n\") {\n290\t\t\ttrimmed := strings.TrimSpace(line)\n291\t\t\tif strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") {\n292\t\t\t\treturn true\n293\t\t\t}\n294\t\t}\n295\t\treturn false\n296\t}\n297\t\n298\t// notesFor returns a human-readable one-liner naming each failure, or\n299\t// \"all checks passed\" on success.\n300\tfunc notesFor(notes []string) string {\n301\t\tif len(notes) == 0 {\n302\t\t\treturn \"all checks passed\"\n303\t\t}\n304\t\treturn strings.Join(notes, \"; \")\n305\t}\n306\t"}]},"parent_tool_use_id":"call_f957bd7b98874acf90e3a141","session_id":"698f096f-a0f8-4a78-ad91-b84cbf89d0ae","uuid":"21ad7927-b3f5-4b17-bfc3-c597d9aa4f96","timestamp":"2026-08-14T23:24:11.514Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec"}
