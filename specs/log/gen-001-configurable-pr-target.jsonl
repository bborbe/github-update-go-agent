{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011Ce3W8FjWGGMmpkQQKn97W","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0184ohJcQxXytaPUtb8e9HP7","name":"Read","input":{"file_path":"/workspace/pkg/gh_cli.go"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7878,"cache_read_input_tokens":18776,"cache_creation":{"ephemeral_5m_input_tokens":7878,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":"call_f957bd7b98874acf90e3a141","session_id":"698f096f-a0f8-4a78-ad91-b84cbf89d0ae","uuid":"61741a37-c37e-490b-b62f-1a488304abf1","timestamp":"2026-08-14T23:24:07.635Z","request_id":"req_011Ce3W8EA14Bxn8auEFPsQz","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0184ohJcQxXytaPUtb8e9HP7","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"encoding/json\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/bborbe/errors\"\n15\t\t\"github.com/golang/glog\"\n16\t)\n17\t\n18\t//counterfeiter:generate -o ../mocks/gh_cli.go --fake-name GhCli . GhCli\n19\t\n20\t// GhCli is the seam between the steps and the gh binary. Three methods\n21\t// cover the agent's entire PR surface: create a DRAFT PR, adopt an\n22\t// already-open PR by head branch (crash-window replay guard), and view\n23\t// PR state for the ai_review checks.\n24\t//\n25\t// Deliberately absent (design § 7.0): no Ready, no Merge — the agent\n26\t// never flips a draft and never merges; the human does.\n27\ttype GhCli interface {\n28\t\t// CreateDraftPR opens a DRAFT pull request from head against base,\n29\t\t// running gh inside workdir so the repo is inferred from the git\n30\t\t// remote. Returns the PR URL.\n31\t\tCreateDraftPR(ctx context.Context, workdir, base, head, title, body string) (string, error)\n32\t\n33\t\t// FindOpenPRByHead returns the URL of an open PR whose head is the\n34\t\t// given branch, or \"\" when none exists. repo is \"owner/name\".\n35\t\tFindOpenPRByHead(ctx context.Context, repo, head string) (string, error)\n36\t\n37\t\t// ViewPR returns the state (e.g. \"OPEN\", \"MERGED\", \"CLOSED\") and\n38\t\t// draft flag of the PR identified by URL.\n39\t\tViewPR(ctx context.Context, prURL string) (state string, isDraft bool, err error)\n40\t}\n41\t\n42\t// NewOSExecGhCli returns a GhCli implementation that shells out to the gh\n43\t// binary with a minimal allowlisted env (GH_TOKEN, HOME, PATH).\n44\tfunc NewOSExecGhCli(ghToken string) GhCli {\n45\t\treturn &osExecGhCli{ghToken: ghToken}\n46\t}\n47\t\n48\ttype osExecGhCli struct {\n49\t\tghToken string\n50\t}\n51\t\n52\t// cmdEnv returns the env allowlist for gh subprocesses. gh needs HOME to\n53\t// locate ~/.config/gh and PATH to resolve git; GH_TOKEN carries the\n54\t// credential. Strict allowlist prevents pod-level secrets from leaking.\n55\tfunc (g *osExecGhCli) cmdEnv() []string {\n56\t\tenv := []string{\n57\t\t\t\"HOME=\" + os.Getenv(\"HOME\"),\n58\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n59\t\t}\n60\t\tif g.ghToken != \"\" {\n61\t\t\tenv = append(env, \"GH_TOKEN=\"+g.ghToken)\n62\t\t}\n63\t\treturn env\n64\t}\n65\t\n66\tfunc (g *osExecGhCli) CreateDraftPR(\n67\t\tctx context.Context,\n68\t\tworkdir, base, head, title, body string,\n69\t) (string, error) {\n70\t\t// gh pr create --draft --base <base> --head <head> --title <title> --body <body>\n71\t\t// --draft is hardcoded: the agent opens drafts only; the human promotes.\n72\t\t// #nosec G204 -- binary is hardcoded gh; workdir is os.TempDir-rooted; head is the deterministic branch name\n73\t\tcmd := exec.CommandContext(\n74\t\t\tctx,\n75\t\t\t\"gh\", \"pr\", \"create\",\n76\t\t\t\"--draft\",\n77\t\t\t\"--base\", base,\n78\t\t\t\"--head\", head,\n79\t\t\t\"--title\", title,\n80\t\t\t\"--body\", body,\n81\t\t)\n82\t\tcmd.Dir = workdir\n83\t\tcmd.Env = g.cmdEnv()\n84\t\tout, err := cmd.CombinedOutput()\n85\t\tif err != nil {\n86\t\t\treturn \"\", errors.Errorf(\n87\t\t\t\tctx,\n88\t\t\t\t\"gh pr create --draft: %s\",\n89\t\t\t\tstrings.TrimSpace(string(out)),\n90\t\t\t)\n91\t\t}\n92\t\t// gh prints the PR URL as the last non-empty stdout line.\n93\t\turl := lastNonEmptyLine(string(out))\n94\t\tglog.V(2).Infof(\"gh pr create --draft succeeded: url=%s head=%s\", url, head)\n95\t\treturn url, nil\n96\t}\n97\t\n98\tfunc (g *osExecGhCli) FindOpenPRByHead(\n99\t\tctx context.Context,\n100\t\trepo, head string,\n101\t) (string, error) {\n102\t\t// gh pr list --repo <repo> --head <head> --state open --json url\n103\t\t// #nosec G204 -- binary is hardcoded gh; repo comes from validated frontmatter; head is deterministic\n104\t\tcmd := exec.CommandContext(\n105\t\t\tctx,\n106\t\t\t\"gh\", \"pr\", \"list\",\n107\t\t\t\"--repo\", repo,\n108\t\t\t\"--head\", head,\n109\t\t\t\"--state\", \"open\",\n110\t\t\t\"--json\", \"url\",\n111\t\t)\n112\t\tcmd.Env = g.cmdEnv()\n113\t\tout, err := cmd.Output()\n114\t\tif err != nil {\n115\t\t\treturn \"\", errors.Wrapf(ctx, err, \"gh pr list --head %s\", head)\n116\t\t}\n117\t\tvar prs []struct {\n118\t\t\tURL string `json:\"url\"`\n119\t\t}\n120\t\tif err := json.Unmarshal(out, &prs); err != nil {\n121\t\t\treturn \"\", errors.Wrap(ctx, err, \"parse gh pr list output\")\n122\t\t}\n123\t\tif len(prs) == 0 {\n124\t\t\treturn \"\", nil\n125\t\t}\n126\t\treturn prs[0].URL, nil\n127\t}\n128\t\n129\tfunc (g *osExecGhCli) ViewPR(\n130\t\tctx context.Context,\n131\t\tprURL string,\n132\t) (string, bool, error) {\n133\t\t// gh pr view <url> --json state,isDraft\n134\t\t// #nosec G204 -- binary is hardcoded gh; prURL comes from the agent's own ## Result section\n135\t\tcmd := exec.CommandContext(ctx, \"gh\", \"pr\", \"view\", prURL, \"--json\", \"state,isDraft\")\n136\t\tcmd.Env = g.cmdEnv()\n137\t\tout, err := cmd.Output()\n138\t\tif err != nil {\n139\t\t\treturn \"\", false, errors.Wrapf(ctx, err, \"gh pr view %s\", prURL)\n140\t\t}\n141\t\tvar pr struct {\n142\t\t\tState   string `json:\"state\"`\n143\t\t\tIsDraft bool   `json:\"isDraft\"`\n144\t\t}\n145\t\tif err := json.Unmarshal(out, &pr); err != nil {\n146\t\t\treturn \"\", false, errors.Wrap(ctx, err, \"parse gh pr view output\")\n147\t\t}\n148\t\treturn pr.State, pr.IsDraft, nil\n149\t}\n150\t\n151\t// lastNonEmptyLine returns the last non-empty line of s (gh prints the PR\n152\t// URL last, after any informational lines).\n153\tfunc lastNonEmptyLine(s string) string {\n154\t\tlines := strings.Split(strings.TrimSpace(s), \"\\n\")\n155\t\tfor i := len(lines) - 1; i >= 0; i-- {\n156\t\t\tif trimmed := strings.TrimSpace(lines[i]); trimmed != \"\" {\n157\t\t\t\treturn trimmed\n158\t\t\t}\n159\t\t}\n160\t\treturn \"\"\n161\t}\n162\t"}]},"parent_tool_use_id":"call_f957bd7b98874acf90e3a141","session_id":"698f096f-a0f8-4a78-ad91-b84cbf89d0ae","uuid":"48d3e246-35ef-4bdb-8ae4-1ef0943e8be2","timestamp":"2026-08-14T23:24:07.670Z","subagent_type":"dark-factory:prompt-creator","task_description":"Generate prompts from spec"}
