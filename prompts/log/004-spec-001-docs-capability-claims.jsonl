{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_7y4ooik5f4ss_1","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"regexp\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\tagentlib \"github.com/bborbe/agent\"\n16\t\t\"github.com/bborbe/errors\"\n17\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n18\t\t\"github.com/golang/glog\"\n19\t\n20\t\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n21\t)\n22\t\n23\t// changelogFileName is the changelog the review verifies.\n24\tconst changelogFileName = \"CHANGELOG.md\"\n25\t\n26\t// versionHeaderRegexp matches released version headers (## v1.2.3 / ## 1.2.3).\n27\tvar versionHeaderRegexp = regexp.MustCompile(`(?m)^## v?\\d+\\.\\d+\\.\\d+`)\n28\t\n29\t// reviewStep implements agentlib.Step for the ai_review phase — a PURE-GO\n30\t// verifier (design D1): every check is derived from independent re-execution\n31\t// on a fresh worktree, never copied from ## Result, and a non-LLM verifier\n32\t// cannot rubber-stamp. The step carries the configured PRTarget so it can\n33\t// compare the observed draft-ness against the configured target rather than\n34\t// unconditionally requiring draft.\n35\ttype reviewStep struct {\n36\t\tops      git.GitOps\n37\t\tgh       GhCli\n38\t\tgate     GateRunner\n39\t\tghToken  string\n40\t\tprTarget PRTarget\n41\t}\n42\t\n43\t// NewReviewStep wires the ai_review verifier with its GitOps seam (fresh\n44\t// clone + tag/rev inspection), gh CLI seam (PR state), gate runner\n45\t// (independent gate re-run), the GitHub token, and the configured PRTarget\n46\t// the step compares observed draft-ness against.\n47\tfunc NewReviewStep(\n48\t\tops git.GitOps,\n49\t\tgh GhCli,\n50\t\tgate GateRunner,\n51\t\tghToken string,\n52\t\tprTarget PRTarget,\n53\t) agentlib.Step {\n54\t\treturn &reviewStep{ops: ops, gh: gh, gate: gate, ghToken: ghToken, prTarget: prTarget}\n55\t}\n56\t\n57\t// Name implements agentlib.Step.\n58\tfunc (s *reviewStep) Name() string { return \"github-update-go-review\" }\n59\t\n60\t// ShouldRun always returns true — a re-trigger overwrites ## Review.\n61\tfunc (s *reviewStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n62\t\treturn true, nil\n63\t}\n64\t\n65\t// Run executes the verification pipeline (design § 4.3 ai_review):\n66\t//  1. Read ## Plan + ## Result (fatal error if either missing).\n67\t//  2. pr_open + draft matches target — `gh pr view` must report OPEN and the\n68\t//     observed draft-ness must match the configured PRTarget.\n69\t//  3. Fresh worktree at the branch; re-run every planned gate target → exit 0\n70\t//     (gate_green; vulns_clear — the gate wraps the scanners).\n71\t//  4. changelog_unreleased — CHANGELOG has an ## Unreleased bullet and no\n72\t//     new version header vs master.\n73\t//  5. no_new_tag — `git ls-remote --tags` shows no tag at any branch commit.\n74\t//  6. All true → ## Review approved + Done/NextPhase human_review (the ONLY\n75\t//     writer of that phase; success semantics per doctrine).\n76\t//     Any false → ## Review approved:false + Status Failed, NO NextPhase.\n77\tfunc (s *reviewStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n78\t\tresult, err := agentlib.ExtractSection[ResultOutput](ctx, md, \"## Result\")\n79\t\tif err != nil || result == nil {\n80\t\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Result section\")\n81\t\t}\n82\t\tplan, err := agentlib.ExtractSection[PlanOutput](ctx, md, \"## Plan\")\n83\t\tif err != nil || plan == nil {\n84\t\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Plan section\")\n85\t\t}\n86\t\n87\t\tvar notes []string\n88\t\tif result.PRURL == \"\" || result.Branch == \"\" {\n89\t\t\treturn s.finish(ctx, md, ReviewOutput{\n90\t\t\t\tApproved: false,\n91\t\t\t\tNotes:    \"## Result carries no pr_url/branch — nothing to verify\",\n92\t\t\t})\n93\t\t}\n94\t\n95\t\tchecks := ReviewChecks{}\n96\t\tdraftMatches := s.checkPR(ctx, result, &checks, &notes)\n97\t\n98\t\tcloneURL, _ := md.Frontmatter.String(\"clone_url\")\n99\t\tref, _ := md.Frontmatter.String(\"ref\")\n100\t\trepo, _ := md.Frontmatter.String(\"repo\")\n101\t\tauthedURL := injectToken(normalizeCloneURLToHTTPS(cloneURL), s.ghToken)\n102\t\n103\t\tworkdir := setupWorkdir(md, repo)\n104\t\tdefer func() {\n105\t\t\tif err := os.RemoveAll(workdir); err != nil {\n106\t\t\t\tglog.Warningf(\"ai_review: workdir cleanup failed: path=%s err=%v\", workdir, err)\n107\t\t\t}\n108\t\t}()\n109\t\n110\t\tif err := s.ops.CloneAtRef(ctx, authedURL, result.Branch, workdir); err != nil {\n111\t\t\t// Fail closed: without the fresh worktree no local check can pass.\n112\t\t\tnotes = append(notes, \"fresh worktree clone failed: \"+git.RedactToken(err.Error()))\n113\t\t} else {\n114\t\t\ts.checkGates(ctx, workdir, plan, &checks, &notes)\n115\t\t\ts.checkChangelog(ctx, workdir, &checks, &notes)\n116\t\t\ts.checkNoNewTag(ctx, workdir, authedURL, ref, &checks, &notes)\n117\t\t}\n118\t\n119\t\tapproved := checks.PROpen && draftMatches && checks.GateGreen &&\n120\t\t\tchecks.VulnsClear && checks.ChangelogUnreleased && checks.NoNewTag\n121\t\toutput := ReviewOutput{\n122\t\t\tApproved: approved,\n123\t\t\tChecks:   checks,\n124\t\t\tNotes:    notesFor(notes),\n125\t\t}\n126\t\treturn s.finish(ctx, md, output)\n127\t}\n128\t\n129\t// finish writes ## Review and maps approved → Done/human_review,\n130\t// rejected → Failed with NO NextPhase (the controller parks; human_review\n131\t// is reserved for end-of-pipeline success).\n132\tfunc (s *reviewStep) finish(\n133\t\tctx context.Context,\n134\t\tmd *agentlib.Markdown,\n135\t\toutput ReviewOutput,\n136\t) (*agentlib.Result, error) {\n137\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Review\", output)\n138\t\tif err != nil {\n139\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Review section\")\n140\t\t}\n141\t\tmd.ReplaceSection(section)\n142\t\n143\t\tif output.Approved {\n144\t\t\tglog.V(2).Infof(\"ai_review: approved — routing human_review\")\n145\t\t\treturn &agentlib.Result{\n146\t\t\t\tStatus:    agentlib.AgentStatusDone,\n147\t\t\t\tNextPhase: domain.TaskPhaseHumanReview.String(),\n148\t\t\t}, nil\n149\t\t}\n150\t\tglog.V(2).Infof(\"ai_review: rejected — %s\", output.Notes)\n151\t\treturn &agentlib.Result{\n152\t\t\tStatus:  agentlib.AgentStatusFailed,\n153\t\t\tMessage: output.Notes,\n154\t\t}, nil\n155\t}\n156\t\n157\t// checkPR verifies the PR is OPEN and that its observed draft-ness matches\n158\t// the configured target. checks.PRDraft keeps reporting the RAW observed\n159\t// draft-ness — the match decision lives in the returned verdict, the\n160\t// approval flag and the notes, so the serialized pr_draft key does not\n161\t// change meaning for downstream consumers. A mismatch means the PR is not\n162\t// in the state the agent created it in (someone flipped it) — surfaced for\n163\t// the operator, and per the check contract the review fails closed.\n164\tfunc (s *reviewStep) checkPR(\n165\t\tctx context.Context,\n166\t\tresult *ResultOutput,\n167\t\tchecks *ReviewChecks,\n168\t\tnotes *[]string,\n169\t) bool {\n170\t\tstate, isDraft, err := s.gh.ViewPR(ctx, result.PRURL)\n171\t\tif err != nil {\n172\t\t\t*notes = append(*notes, \"gh pr view failed: \"+err.Error())\n173\t\t\treturn false\n174\t\t}\n175\t\tchecks.PROpen = state == \"OPEN\"\n176\t\tchecks.PRDraft = isDraft\n177\t\tif !checks.PROpen {\n178\t\t\t*notes = append(*notes, \"pr state is \"+state+\", expected OPEN\")\n179\t\t}\n180\t\tdraftMatches := isDraft == s.prTarget.IsDraft()\n181\t\tif !draftMatches {\n182\t\t\t*notes = append(*notes, \"pr draft-ness mismatch: observed draft=\"+\n183\t\t\t\tstrconv.FormatBool(isDraft)+\", configured target=\"+s.prTarget.String())\n184\t\t}\n185\t\treturn draftMatches\n186\t}\n187\t\n188\t// checkGates independently re-runs every planned gate target on the fresh\n189\t// worktree. gate_green is derived from THIS re-execution, never from\n190\t// Result.gate_exit (design § 4.4). vulns_clear rides the same run — the\n191\t// repo's gate targets wrap the scanners (design § 7.3).\n192\tfunc (s *reviewStep) checkGates(\n193\t\tctx context.Context,\n194\t\tworkdir string,\n195\t\tplan *PlanOutput,\n196\t\tchecks *ReviewChecks,\n197\t\tnotes *[]string,\n198\t) {\n199\t\tif len(plan.GateTargets) == 0 {\n200\t\t\t*notes = append(*notes, \"plan carries no gate_targets\")\n201\t\t\treturn\n202\t\t}\n203\t\tfor _, target := range plan.GateTargets {\n204\t\t\ttail, exitCode, err := s.gate.RunTarget(ctx, workdir, target)\n205\t\t\tif err != nil {\n206\t\t\t\t*notes = append(*notes, \"gate target \"+target+\" red (exit \"+\n207\t\t\t\t\tstrconv.Itoa(exitCode)+\"): \"+tail)\n208\t\t\t\treturn\n209\t\t\t}\n210\t\t}\n211\t\tchecks.GateGreen = true\n212\t\tchecks.VulnsClear = true\n213\t}\n214\t\n215\t// checkChangelog verifies CHANGELOG.md on the branch carries at least one\n216\t// bullet under ## Unreleased and introduces NO new version header compared\n217\t// to origin/master (the release agent finalizes versions on merge — a new\n218\t// header here means the update finalized a version, which is forbidden).\n219\tfunc (s *reviewStep) checkChangelog(\n220\t\tctx context.Context,\n221\t\tworkdir string,\n222\t\tchecks *ReviewChecks,\n223\t\tnotes *[]string,\n224\t) {\n225\t\tbranchContent, err := os.ReadFile(\n226\t\t\tfilepath.Join(workdir, changelogFileName),\n227\t\t) // #nosec G304 -- workdir is os.TempDir-rooted; filename is constant\n228\t\tif err != nil {\n229\t\t\t*notes = append(*notes, \"read CHANGELOG.md failed: \"+err.Error())\n230\t\t\treturn\n231\t\t}\n232\t\tif !hasUnreleasedBullet(string(branchContent)) {\n233\t\t\t*notes = append(*notes, \"CHANGELOG has no bullet under ## Unreleased\")\n234\t\t\treturn\n235\t\t}\n236\t\tmasterContent, err := s.ops.ShowFile(ctx, workdir, \"origin/master\", changelogFileName)\n237\t\tif err != nil {\n238\t\t\t*notes = append(*notes, \"read master CHANGELOG failed: \"+err.Error())\n239\t\t\treturn\n240\t\t}\n241\t\tmasterHeaders := map[string]struct{}{}\n242\t\tfor _, h := range versionHeaderRegexp.FindAllString(string(masterContent), -1) {\n243\t\t\tmasterHeaders[h] = struct{}{}\n244\t\t}\n245\t\tfor _, h := range versionHeaderRegexp.FindAllString(string(branchContent), -1) {\n246\t\t\tif _, ok := masterHeaders[h]; !ok {\n247\t\t\t\t*notes = append(*notes, \"CHANGELOG introduces new version header \"+h+\n248\t\t\t\t\t\" — versioning is the release agent's job on merge\")\n249\t\t\t\treturn\n250\t\t\t}\n251\t\t}\n252\t\tchecks.ChangelogUnreleased = true\n253\t}\n254\t\n255\t// checkNoNewTag verifies the remote holds no tag pointing at any branch\n256\t// commit (git ls-remote --tags unchanged with respect to the branch work).\n257\tfunc (s *reviewStep) checkNoNewTag(\n258\t\tctx context.Context,\n259\t\tworkdir, authedURL, ref string,\n260\t\tchecks *ReviewChecks,\n261\t\tnotes *[]string,\n262\t) {\n263\t\tif ref == \"\" {\n264\t\t\t*notes = append(*notes, \"frontmatter ref missing — cannot compute branch commits\")\n265\t\t\treturn\n266\t\t}\n267\t\tbranchCommits, err := s.ops.RevList(ctx, workdir, ref)\n268\t\tif err != nil {\n269\t\t\t*notes = append(*notes, \"rev-list failed: \"+err.Error())\n270\t\t\treturn\n271\t\t}\n272\t\ttagSHAs, err := s.ops.LsRemoteTags(ctx, authedURL)\n273\t\tif err != nil {\n274\t\t\t*notes = append(*notes, \"ls-remote --tags failed: \"+git.RedactToken(err.Error()))\n275\t\t\treturn\n276\t\t}\n277\t\tcommitSet := map[string]struct{}{}\n278\t\tfor _, sha := range branchCommits {\n279\t\t\tcommitSet[sha] = struct{}{}\n280\t\t}\n281\t\tfor _, sha := range tagSHAs {\n282\t\t\tif _, ok := commitSet[sha]; ok {\n283\t\t\t\t*notes = append(*notes, \"remote tag points at branch commit \"+sha+\n284\t\t\t\t\t\" — a tag leaked from the update pipeline\")\n285\t\t\t\treturn\n286\t\t\t}\n287\t\t}\n288\t\tchecks.NoNewTag = true\n289\t}\n290\t\n291\t// hasUnreleasedBullet reports whether the ## Unreleased section contains at\n292\t// least one markdown bullet before the next ## heading.\n293\tfunc hasUnreleasedBullet(content string) bool {\n294\t\tidx := strings.Index(content, \"## Unreleased\")\n295\t\tif idx < 0 {\n296\t\t\treturn false\n297\t\t}\n298\t\tbody := content[idx+len(\"## Unreleased\"):]\n299\t\tif next := strings.Index(body, \"\\n## \"); next >= 0 {\n300\t\t\tbody = body[:next]\n301\t\t}\n302\t\tfor _, line := range strings.Split(body, \"\\n\") {\n303\t\t\ttrimmed := strings.TrimSpace(line)\n304\t\t\tif strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") {\n305\t\t\t\treturn true\n306\t\t\t}\n307\t\t}\n308\t\treturn false\n309\t}\n310\t\n311\t// notesFor returns a human-readable one-liner naming each failure, or\n312\t// \"all checks passed\" on success.\n313\tfunc notesFor(notes []string) string {\n314\t\tif len(notes) == 0 {\n315\t\t\treturn \"all checks passed\"\n316\t\t}\n317\t\treturn strings.Join(notes, \"; \")\n318\t}\n319\t"}]},"parent_tool_use_id":null,"session_id":"dce1beef-dda6-45eb-834d-9061449d4a84","uuid":"206d465b-f511-4a33-b6a9-ca44e57be4c5","timestamp":"2026-08-15T08:39:54.366Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/steps_review.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\t\"github.com/bborbe/errors\"\n\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n\t\"github.com/golang/glog\"\n\n\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n)\n\n// changelogFileName is the changelog the review verifies.\nconst changelogFileName = \"CHANGELOG.md\"\n\n// versionHeaderRegexp matches released version headers (## v1.2.3 / ## 1.2.3).\nvar versionHeaderRegexp = regexp.MustCompile(`(?m)^## v?\\d+\\.\\d+\\.\\d+`)\n\n// reviewStep implements agentlib.Step for the ai_review phase — a PURE-GO\n// verifier (design D1): every check is derived from independent re-execution\n// on a fresh worktree, never copied from ## Result, and a non-LLM verifier\n// cannot rubber-stamp. The step carries the configured PRTarget so it can\n// compare the observed draft-ness against the configured target rather than\n// unconditionally requiring draft.\ntype reviewStep struct {\n\tops      git.GitOps\n\tgh       GhCli\n\tgate     GateRunner\n\tghToken  string\n\tprTarget PRTarget\n}\n\n// NewReviewStep wires the ai_review verifier with its GitOps seam (fresh\n// clone + tag/rev inspection), gh CLI seam (PR state), gate runner\n// (independent gate re-run), the GitHub token, and the configured PRTarget\n// the step compares observed draft-ness against.\nfunc NewReviewStep(\n\tops git.GitOps,\n\tgh GhCli,\n\tgate GateRunner,\n\tghToken string,\n\tprTarget PRTarget,\n) agentlib.Step {\n\treturn &reviewStep{ops: ops, gh: gh, gate: gate, ghToken: ghToken, prTarget: prTarget}\n}\n\n// Name implements agentlib.Step.\nfunc (s *reviewStep) Name() string { return \"github-update-go-review\" }\n\n// ShouldRun always returns true — a re-trigger overwrites ## Review.\nfunc (s *reviewStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n\treturn true, nil\n}\n\n// Run executes the verification pipeline (design § 4.3 ai_review):\n//  1. Read ## Plan + ## Result (fatal error if either missing).\n//  2. pr_open + draft matches target — `gh pr view` must report OPEN and the\n//     observed draft-ness must match the configured PRTarget.\n//  3. Fresh worktree at the branch; re-run every planned gate target → exit 0\n//     (gate_green; vulns_clear — the gate wraps the scanners).\n//  4. changelog_unreleased — CHANGELOG has an ## Unreleased bullet and no\n//     new version header vs master.\n//  5. no_new_tag — `git ls-remote --tags` shows no tag at any branch commit.\n//  6. All true → ## Review approved + Done/NextPhase human_review (the ONLY\n//     writer of that phase; success semantics per doctrine).\n//     Any false → ## Review approved:false + Status Failed, NO NextPhase.\nfunc (s *reviewStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n\tresult, err := agentlib.ExtractSection[ResultOutput](ctx, md, \"## Result\")\n\tif err != nil || result == nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Result section\")\n\t}\n\tplan, err := agentlib.ExtractSection[PlanOutput](ctx, md, \"## Plan\")\n\tif err != nil || plan == nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"ai_review: extract ## Plan section\")\n\t}\n\n\tvar notes []string\n\tif result.PRURL == \"\" || result.Branch == \"\" {\n\t\treturn s.finish(ctx, md, ReviewOutput{\n\t\t\tApproved: false,\n\t\t\tNotes:    \"## Result carries no pr_url/branch — nothing to verify\",\n\t\t})\n\t}\n\n\tchecks := ReviewChecks{}\n\tdraftMatches := s.checkPR(ctx, result, &checks, &notes)\n\n\tcloneURL, _ := md.Frontmatter.String(\"clone_url\")\n\tref, _ := md.Frontmatter.String(\"ref\")\n\trepo, _ := md.Frontmatter.String(\"repo\")\n\tauthedURL := injectToken(normalizeCloneURLToHTTPS(cloneURL), s.ghToken)\n\n\tworkdir := setupWorkdir(md, repo)\n\tdefer func() {\n\t\tif err := os.RemoveAll(workdir); err != nil {\n\t\t\tglog.Warningf(\"ai_review: workdir cleanup failed: path=%s err=%v\", workdir, err)\n\t\t}\n\t}()\n\n\tif err := s.ops.CloneAtRef(ctx, authedURL, result.Branch, workdir); err != nil {\n\t\t// Fail closed: without the fresh worktree no local check can pass.\n\t\tnotes = append(notes, \"fresh worktree clone failed: \"+git.RedactToken(err.Error()))\n\t} else {\n\t\ts.checkGates(ctx, workdir, plan, &checks, &notes)\n\t\ts.checkChangelog(ctx, workdir, &checks, &notes)\n\t\ts.checkNoNewTag(ctx, workdir, authedURL, ref, &checks, &notes)\n\t}\n\n\tapproved := checks.PROpen && draftMatches && checks.GateGreen &&\n\t\tchecks.VulnsClear && checks.ChangelogUnreleased && checks.NoNewTag\n\toutput := ReviewOutput{\n\t\tApproved: approved,\n\t\tChecks:   checks,\n\t\tNotes:    notesFor(notes),\n\t}\n\treturn s.finish(ctx, md, output)\n}\n\n// finish writes ## Review and maps approved → Done/human_review,\n// rejected → Failed with NO NextPhase (the controller parks; human_review\n// is reserved for end-of-pipeline success).\nfunc (s *reviewStep) finish(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\toutput ReviewOutput,\n) (*agentlib.Result, error) {\n\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Review\", output)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Review section\")\n\t}\n\tmd.ReplaceSection(section)\n\n\tif output.Approved {\n\t\tglog.V(2).Infof(\"ai_review: approved — routing human_review\")\n\t\treturn &agentlib.Result{\n\t\t\tStatus:    agentlib.AgentStatusDone,\n\t\t\tNextPhase: domain.TaskPhaseHumanReview.String(),\n\t\t}, nil\n\t}\n\tglog.V(2).Infof(\"ai_review: rejected — %s\", output.Notes)\n\treturn &agentlib.Result{\n\t\tStatus:  agentlib.AgentStatusFailed,\n\t\tMessage: output.Notes,\n\t}, nil\n}\n\n// checkPR verifies the PR is OPEN and that its observed draft-ness matches\n// the configured target. checks.PRDraft keeps reporting the RAW observed\n// draft-ness — the match decision lives in the returned verdict, the\n// approval flag and the notes, so the serialized pr_draft key does not\n// change meaning for downstream consumers. A mismatch means the PR is not\n// in the state the agent created it in (someone flipped it) — surfaced for\n// the operator, and per the check contract the review fails closed.\nfunc (s *reviewStep) checkPR(\n\tctx context.Context,\n\tresult *ResultOutput,\n\tchecks *ReviewChecks,\n\tnotes *[]string,\n) bool {\n\tstate, isDraft, err := s.gh.ViewPR(ctx, result.PRURL)\n\tif err != nil {\n\t\t*notes = append(*notes, \"gh pr view failed: \"+err.Error())\n\t\treturn false\n\t}\n\tchecks.PROpen = state == \"OPEN\"\n\tchecks.PRDraft = isDraft\n\tif !checks.PROpen {\n\t\t*notes = append(*notes, \"pr state is \"+state+\", expected OPEN\")\n\t}\n\tdraftMatches := isDraft == s.prTarget.IsDraft()\n\tif !draftMatches {\n\t\t*notes = append(*notes, \"pr draft-ness mismatch: observed draft=\"+\n\t\t\tstrconv.FormatBool(isDraft)+\", configured target=\"+s.prTarget.String())\n\t}\n\treturn draftMatches\n}\n\n// checkGates independently re-runs every planned gate target on the fresh\n// worktree. gate_green is derived from THIS re-execution, never from\n// Result.gate_exit (design § 4.4). vulns_clear rides the same run — the\n// repo's gate targets wrap the scanners (design § 7.3).\nfunc (s *reviewStep) checkGates(\n\tctx context.Context,\n\tworkdir string,\n\tplan *PlanOutput,\n\tchecks *ReviewChecks,\n\tnotes *[]string,\n) {\n\tif len(plan.GateTargets) == 0 {\n\t\t*notes = append(*notes, \"plan carries no gate_targets\")\n\t\treturn\n\t}\n\tfor _, target := range plan.GateTargets {\n\t\ttail, exitCode, err := s.gate.RunTarget(ctx, workdir, target)\n\t\tif err != nil {\n\t\t\t*notes = append(*notes, \"gate target \"+target+\" red (exit \"+\n\t\t\t\tstrconv.Itoa(exitCode)+\"): \"+tail)\n\t\t\treturn\n\t\t}\n\t}\n\tchecks.GateGreen = true\n\tchecks.VulnsClear = true\n}\n\n// checkChangelog verifies CHANGELOG.md on the branch carries at least one\n// bullet under ## Unreleased and introduces NO new version header compared\n// to origin/master (the release agent finalizes versions on merge — a new\n// header here means the update finalized a version, which is forbidden).\nfunc (s *reviewStep) checkChangelog(\n\tctx context.Context,\n\tworkdir string,\n\tchecks *ReviewChecks,\n\tnotes *[]string,\n) {\n\tbranchContent, err := os.ReadFile(\n\t\tfilepath.Join(workdir, changelogFileName),\n\t) // #nosec G304 -- workdir is os.TempDir-rooted; filename is constant\n\tif err != nil {\n\t\t*notes = append(*notes, \"read CHANGELOG.md failed: \"+err.Error())\n\t\treturn\n\t}\n\tif !hasUnreleasedBullet(string(branchContent)) {\n\t\t*notes = append(*notes, \"CHANGELOG has no bullet under ## Unreleased\")\n\t\treturn\n\t}\n\tmasterContent, err := s.ops.ShowFile(ctx, workdir, \"origin/master\", changelogFileName)\n\tif err != nil {\n\t\t*notes = append(*notes, \"read master CHANGELOG failed: \"+err.Error())\n\t\treturn\n\t}\n\tmasterHeaders := map[string]struct{}{}\n\tfor _, h := range versionHeaderRegexp.FindAllString(string(masterContent), -1) {\n\t\tmasterHeaders[h] = struct{}{}\n\t}\n\tfor _, h := range versionHeaderRegexp.FindAllString(string(branchContent), -1) {\n\t\tif _, ok := masterHeaders[h]; !ok {\n\t\t\t*notes = append(*notes, \"CHANGELOG introduces new version header \"+h+\n\t\t\t\t\" — versioning is the release agent's job on merge\")\n\t\t\treturn\n\t\t}\n\t}\n\tchecks.ChangelogUnreleased = true\n}\n\n// checkNoNewTag verifies the remote holds no tag pointing at any branch\n// commit (git ls-remote --tags unchanged with respect to the branch work).\nfunc (s *reviewStep) checkNoNewTag(\n\tctx context.Context,\n\tworkdir, authedURL, ref string,\n\tchecks *ReviewChecks,\n\tnotes *[]string,\n) {\n\tif ref == \"\" {\n\t\t*notes = append(*notes, \"frontmatter ref missing — cannot compute branch commits\")\n\t\treturn\n\t}\n\tbranchCommits, err := s.ops.RevList(ctx, workdir, ref)\n\tif err != nil {\n\t\t*notes = append(*notes, \"rev-list failed: \"+err.Error())\n\t\treturn\n\t}\n\ttagSHAs, err := s.ops.LsRemoteTags(ctx, authedURL)\n\tif err != nil {\n\t\t*notes = append(*notes, \"ls-remote --tags failed: \"+git.RedactToken(err.Error()))\n\t\treturn\n\t}\n\tcommitSet := map[string]struct{}{}\n\tfor _, sha := range branchCommits {\n\t\tcommitSet[sha] = struct{}{}\n\t}\n\tfor _, sha := range tagSHAs {\n\t\tif _, ok := commitSet[sha]; ok {\n\t\t\t*notes = append(*notes, \"remote tag points at branch commit \"+sha+\n\t\t\t\t\" — a tag leaked from the update pipeline\")\n\t\t\treturn\n\t\t}\n\t}\n\tchecks.NoNewTag = true\n}\n\n// hasUnreleasedBullet reports whether the ## Unreleased section contains at\n// least one markdown bullet before the next ## heading.\nfunc hasUnreleasedBullet(content string) bool {\n\tidx := strings.Index(content, \"## Unreleased\")\n\tif idx < 0 {\n\t\treturn false\n\t}\n\tbody := content[idx+len(\"## Unreleased\"):]\n\tif next := strings.Index(body, \"\\n## \"); next >= 0 {\n\t\tbody = body[:next]\n\t}\n\tfor _, line := range strings.Split(body, \"\\n\") {\n\t\ttrimmed := strings.TrimSpace(line)\n\t\tif strings.HasPrefix(trimmed, \"- \") || strings.HasPrefix(trimmed, \"* \") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\n// notesFor returns a human-readable one-liner naming each failure, or\n// \"all checks passed\" on success.\nfunc notesFor(notes []string) string {\n\tif len(notes) == 0 {\n\t\treturn \"all checks passed\"\n\t}\n\treturn strings.Join(notes, \"; \")\n}\n","numLines":319,"startLine":1,"totalLines":319}}}
