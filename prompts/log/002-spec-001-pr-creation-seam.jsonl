Ops{}\n65\t\t\tgh = &mocks.GhCli{}\n66\t\t\tgate = &mocks.GateRunner{}\n67\t\t\tstep = pkg.NewExecutionStep(runner, ops, gh, gate, \"tok\")\n68\t\t\tvar err error\n69\t\t\tmd, err = agentlib.ParseMarkdown(ctx, executionTaskMD)\n70\t\t\tExpect(err).To(BeNil())\n71\t\n72\t\t\trunner.RunReturns(&claudelib.ClaudeResult{\n73\t\t\t\tResult: `{\"deps_updated\": 5, \"vulns_fixed\": [\"GO-2026-1234\"], \"notes\": \"ok\"}`,\n74\t\t\t}, nil)\n75\t\t\tgate.RunTargetReturns(\"\", 0, nil)\n76\t\t\tops.ChangedFilesReturns([]string{\"go.mod\", \"go.sum\", \"CHANGELOG.md\"}, nil)\n77\t\t\tops.CommitReturns(\"abc1234\", nil)\n78\t\t\tops.CommittedFilesReturns([]string{\"go.mod\", \"go.sum\", \"CHANGELOG.md\"}, nil)\n79\t\t\tgh.CreateDraftPRReturns(\"https://github.com/bborbe/demo/pull/42\", nil)\n80\t\t})\n81\t\n82\t\tDescribe(\"replay guard\", func() {\n83\t\t\tBeforeEach(func() {\n84\t\t\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", pkg.ResultOutput{\n85\t\t\t\t\tOutcome: pkg.ResultOutcomeOpened,\n86\t\t\t\t\tBranch:  \"fix/update-go-6d1f27f\",\n87\t\t\t\t\tPRURL:   \"https://github.com/bborbe/demo/pull/42\",\n88\t\t\t\t})\n89\t\t\t\tExpect(err).To(BeNil())\n90\t\t\t\tmd.ReplaceSection(section)\n91\t\t\t})\n92\t\n93\t\t\tIt(\"re-routes to ai_review without redoing side effects\", func() {\n94\t\t\t\tresult, err := step.Run(ctx, md)\n95\t\t\t\tExpect(err).To(BeNil())\n96\t\t\t\tExpect(result.Status).To(Equal(agentlib.AgentStatusDone))\n97\t\t\t\tExpect(result.NextPhase).To(Equal(\"ai_review\"))\n98\t\t\t\tExpect(ops.CloneAtRefCallCount()).To(Equal(0))\n99\t\t\t\tExpect(ops.PushCallCount()).To(Equal(0))\n100\t\t\t\tExpect(gh.CreateDraftPRCallCount()).To(Equal(0))\n101\t\t\t})\n102\t\t})\n103\t\n104\t\tDescribe(\"failed prior ## Result does NOT re-route\", func() {\n105\t\t\tBeforeEach(func() {\n106\t\t\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", pkg.ResultOutput{\n107\t\t\t\t\tOutcome: pkg.ResultOutcomeFailed,\n108\t\t\t\t\tError:   \"gate red\",\n109\t\t\t\t})\n110\t\t\t\tExpect(err).To(BeNil())\n111\t\t\t\tmd.ReplaceSection(section)\n112\t\t\t})\n113\t\n114\t\t\tIt(\"re-runs the pipeline\", func() {\n115\t\t\t\tresult, err := step.Run(ctx, md)\n116\t\t\t\tExpect(err).To(BeNil())\n117\t\t\t\tExpect(result.Status).To(Equal(agentlib.AgentStatusDone))\n118\t\t\t\tExpect(ops.CloneAtRefCallCount()).To(Equal(1))\n119\t\t\t})\n120\t\t})\n121\t\n122\t\tDescribe(\"PR adopt guard (crash window)\", func() {\n123\t\t\tBeforeEach(func() {\n124\t\t\t\tgh.FindOpenPRByHeadReturns(\"https://github.com/bborbe/demo/pull/41\", nil)\n125\t\t\t})\n126\t\n127\t\t\tIt(\"adopts the open PR and writes ## Result without pushing\", func() {\n128\t\t\t\tresult, err := step.Run(ctx, md)\n129\t\t\t\tExpect(err).To(BeNil())\n130\t\t\t\tExpect(result.Status).To(Equal(agentlib.AgentStatusDone))\n131\t\t\t\tExpect(result.NextPhase).To(Equal(\"ai_review\"))\n132\t\t\t\tExpect(ops.PushCallCount()).To(Equal(0))\n133\t\n134\t\t\t\tout, err := agentlib.ExtractSection[pkg.ResultOutput](ctx, md, \"## Result\")\n135\t\t\t\tExpect(err).To(BeNil())\n136\t\t\t\tExpect(out.Outcome).To(Equal(pkg.ResultOutcomeAdopted))\n137\t\t\t\tExpect(out.Branch).To(Equal(\"fix/update-go-6d1f27f\"))\n138\t\t\t\tExpect(out.PRURL).To(Equal(\"https://github.com/bborbe/demo/pull/41\"))\n139\t\t\t})\n140\t\t})\n141\t\n142\t\tDescribe(\"happy path\", func() {\n143\t\t\tIt(\"clones at ref, branches deterministically, pushes, opens a draft PR\", func() {\n144\t\t\t\tresult, err := step.Run(ctx, md)\n145\t\t\t\tExpect(err).To(BeNil())\n146\t\t\t\tExpect(result.Status).To(Equal(agentlib.AgentStatusDone))\n147\t\t\t\tExpect(result.NextPhase).To(Equal(\"ai_review\"))\n148\t\n149\t\t\t\t_, url, ref, _ := ops.CloneAtRefArgsForCall(0)\n150\t\t\t\tExpect(url).To(Equal(\"https://x-access-token:tok@github.com/bborbe/demo.git\"))\n151\t\t\t\tExpect(ref).To(Equal(\"6d1f27fabcdef12345678901234567890abcdef1\"))\n152\t\n153\t\t\t\t_, _, branch := ops.SwitchNewBranchArgsForCall(0)\n1