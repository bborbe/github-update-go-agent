 -- binary is hardcoded gh; workdir is os.TempDir-rooted; head is the deterministic branch name\n\tcmd := exec.CommandContext(ctx, \"gh\", prCreateArgs(base, head, title, body, target)...)\n\tcmd.Dir = workdir\n\tcmd.Env = g.cmdEnv()\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\treturn \"\", errors.Errorf(\n\t\t\tctx,\n\t\t\t\"gh pr create (target=%s): %s\",\n\t\t\ttarget,\n\t\t\tstrings.TrimSpace(string(out)),\n\t\t)\n\t}\n\t// gh prints the PR URL as the last non-empty stdout line.\n\turl := lastNonEmptyLine(string(out))\n\tglog.V(2).Infof(\"gh pr create (target=%s) succeeded: url=%s head=%s\", target, url, head)\n\treturn url, nil\n}"}}],"model":"MiniMax-M2.7-highspeed","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":40571,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":23786},"context_management":null},"parent_tool_use_id":null,"session_id":"ef341d7c-598a-44a9-af65-46186c69de29","uuid":"282e01fa-464c-4ad6-8c2b-e4a9ff1bbebf","timestamp":"2026-08-15T08:26:11.599Z"}
