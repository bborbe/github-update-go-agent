{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_6ulp3h9ku0r6_1","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\tpackage pkg\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\n13\t\tagentlib \"github.com/bborbe/agent\"\n14\t\tclaudelib \"github.com/bborbe/agent/claude\"\n15\t\t\"github.com/bborbe/errors\"\n16\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n17\t\t\"github.com/golang/glog\"\n18\t\n19\t\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n20\t\t\"github.com/bborbe/github-update-go-agent/pkg/prompts\"\n21\t)\n22\t\n23\t// branchPrefix is the deterministic work-branch prefix; the full branch is\n24\t// branchPrefix + ref[:7]. Determinism is the crash-window replay guard: a\n25\t// replayed task computes the same branch and adopts the existing PR instead\n26\t// of pushing a duplicate (design § 5.3).\n27\tconst branchPrefix = \"fix/update-go-\"\n28\t\n29\t// prTitle is the fixed draft-PR title (Stage-1 contract).\n30\tconst prTitle = \"update go module dependencies\"\n31\t\n32\t// workflowsPrefix is the forbidden commit path. The committed-files guard\n33\t// rejects it before push AND the GitHub App lacks the Workflows permission\n34\t// (design D3) — belt + suspenders.\n35\tconst workflowsPrefix = \".github/workflows/\"\n36\t\n37\t// executionReport is the small JSON the execution Claude sub-call returns:\n38\t// metadata about what it changed. Best-effort — the deterministic gate\n39\t// re-run is the actual verdict.\n40\ttype executionReport struct {\n41\t\tDepsUpdated int      `json:\"deps_updated\"`\n42\t\tVulnsFixed  []string `json:\"vulns_fixed\"`\n43\t\tNotes       string   `json:\"notes\"`\n44\t\tBlocked     string   `json:\"blocked\"`\n45\t}\n46\t\n47\t// executionStep implements agentlib.Step for the execution phase: a custom\n48\t// Go step embedding one Claude sub-call. All git/gh side effects are the Go\n49\t// step's — the Claude sub-call has NO git and NO gh tools (design § 7.0).\n50\ttype executionStep struct {\n51\t\trunner  claudelib.ClaudeRunner\n52\t\tops     git.GitOps\n53\t\tgh      GhCli\n54\t\tgate    GateRunner\n55\t\tghToken string\n56\t}\n57\t\n58\t// NewExecutionStep wires the execution step with its four seams: the Claude\n59\t// runner (update + repair sub-call), the GitOps seam (clone/branch/commit/\n60\t// push), the gh CLI seam (draft PR create + adopt), and the gate runner\n61\t// (deterministic green-gate re-run).\n62\tfunc NewExecutionStep(\n63\t\trunner claudelib.ClaudeRunner,\n64\t\tops git.GitOps,\n65\t\tgh GhCli,\n66\t\tgate GateRunner,\n67\t\tghToken string,\n68\t) agentlib.Step {\n69\t\treturn &executionStep{runner: runner, ops: ops, gh: gh, gate: gate, ghToken: ghToken}\n70\t}\n71\t\n72\t// Name implements agentlib.Step.\n73\tfunc (s *executionStep) Name() string { return \"github-update-go-execute\" }\n74\t\n75\t// ShouldRun always returns true; the replay guard lives inside Run\n76\t// (dark-factory pattern) so a crash-window replay can re-route without\n77\t// redoing side effects.\n78\tfunc (s *executionStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n79\t\treturn true, nil\n80\t}\n81\t\n82\t// Run executes the update pipeline:\n83\t//  1. Replay guard — existing successful ## Result → re-route to ai_review.\n84\t//  2. Read ## Plan (must be ready + has_work) + frontmatter.\n85\t//  3. PR-adopt guard — open PR for the deterministic branch → adopt, write\n86\t//     ## Result, re-route (crash-window idempotency, design § 5.3).\n87\t//  4. CloneAtRef + SwitchNewBranch fix/update-go-<ref:7>.\n88\t//  5. Claude sub-call (file-edit + go/make only) — update + repair + CHANGELOG.\n89\t//  6. Deterministic gate re-run of the plan's gate targets → red = Failed\n90\t//     with the failing target + output tail.\n91\t//  7. No-effective-change guard — changed files empty or ⊆ {CHANGELOG.md}\n92\t//     (MVS no-op despite planning's has_work=true) → ## Result\n93\t//     outcome=no_update_needed, Done/NextPhase done, workdir discarded; no\n94\t//     commit/push/PR (go-skeleton PR #51 guard).\n95\t//  8. Changed/committed-files guard — reject .github/workflows/** edits.\n96\t//  9. Commit (explicit pathspec, bot identity) + Push (--no-follow-tags) +\n97\t//     gh pr create --draft.\n98\t//  10. ## Result → Done / NextPhase ai_review.\n99\tfunc (s *executionStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n100\t\tif reroute := s.replayGuard(ctx, md); reroute != nil {\n101\t\t\treturn reroute, nil\n102\t\t}\n103\t\n104\t\tplan, err := s.validatePlan(ctx, md)\n105\t\tif err != nil {\n106\t\t\treturn s.fail(ctx, md, &ResultOutput{}, git.ErrorCategoryUnknown, err)\n107\t\t}\n108\t\n109\t\trepo, cloneURL, ref, err := s.extractFrontmatter(ctx, md)\n110\t\tif err != nil {\n111\t\t\treturn s.fail(ctx, md, &ResultOutput{}, git.ErrorCategoryUnknown, err)\n112\t\t}\n113\t\tbranch := branchPrefix + ref[:7]\n114\t\n115\t\tif adopt := s.adoptExistingPR(ctx, md, repo, branch); adopt != nil {\n116\t\t\treturn adopt, nil\n117\t\t}\n118\t\n119\t\tworkdir := setupWorkdir(md, repo)\n120\t\tdefer func() {\n121\t\t\tif err := os.RemoveAll(workdir); err != nil {\n122\t\t\t\tglog.Warningf(\"execution: workdir cleanup failed: path=%s err=%v\", workdir, err)\n123\t\t\t}\n124\t\t}()\n125\t\n126\t\tresult := &ResultOutput{Branch: branch}\n127\t\tauthedURL := injectToken(normalizeCloneURLToHTTPS(cloneURL), s.ghToken)\n128\t\tif err := s.ops.CloneAtRef(ctx, authedURL, ref, workdir); err != nil {\n129\t\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n130\t\t}\n131\t\tif err := s.ops.SwitchNewBranch(ctx, workdir, branch); err != nil {\n132\t\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n133\t\t}\n134\t\n135\t\treport, claudeErr := s.runUpdate(ctx, workdir, plan)\n136\t\tif claudeErr != nil {\n137\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, claudeErr)\n138\t\t}\n139\t\n140\t\tif failResult, err := s.rerunGates(ctx, md, workdir, plan, result, report); failResult != nil ||\n141\t\t\terr != nil {\n142\t\t\treturn failResult, err\n143\t\t}\n144\t\n145\t\treturn s.commitPushAndOpenPR(ctx, md, workdir, branch, plan, report, result)\n146\t}\n147\t\n148\t// replayGuard re-routes when a prior run already produced a successful\n149\t// ## Result — the draft PR exists; redoing clone/push would duplicate work.\n150\t// A failed ## Result does NOT re-route: the phase is the resume cursor and\n151\t// a retry re-runs the pipeline.\n152\tfunc (s *executionStep) replayGuard(\n153\t\tctx context.Context,\n154\t\tmd *agentlib.Markdown,\n155\t) *agentlib.Result {\n156\t\tprior, err := agentlib.ExtractSection[ResultOutput](ctx, md, \"## Result\")\n157\t\tif err != nil || prior == nil {\n158\t\t\treturn nil\n159\t\t}\n160\t\tif prior.Outcome != ResultOutcomeOpened && prior.Outcome != ResultOutcomeAdopted {\n161\t\t\treturn nil\n162\t\t}\n163\t\tglog.V(2).Infof(\n164\t\t\t\"execution: replay guard — ## Result already %s (pr=%s), re-routing to ai_review\",\n165\t\t\tprior.Outcome, prior.PRURL,\n166\t\t)\n167\t\treturn &agentlib.Result{\n168\t\t\tStatus:    agentlib.AgentStatusDone,\n169\t\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n170\t\t}\n171\t}\n172\t\n173\t// adoptExistingPR is the crash-window guard: the branch name is\n174\t// deterministic, so if an open PR for it already exists (a prior run pushed\n175\t// + created the PR but crashed before ## Result landed), adopt it instead of\n176\t// re-pushing. Errors are logged and ignored — the subsequent push would\n177\t// surface a real problem loudly.\n178\tfunc (s *executionStep) adoptExistingPR(\n179\t\tctx context.Context,\n180\t\tmd *agentlib.Markdown,\n181\t\trepo, branch string,\n182\t) *agentlib.Result {\n183\t\turl, err := s.gh.FindOpenPRByHead(ctx, repo, branch)\n184\t\tif err != nil {\n185\t\t\tglog.Warningf(\"execution: pr-adopt lookup failed (continuing): %v\", err)\n186\t\t\treturn nil\n187\t\t}\n188\t\tif url == \"\" {\n189\t\t\treturn nil\n190\t\t}\n191\t\tglog.V(2).Infof(\"execution: adopting existing PR %s for branch %s\", url, branch)\n192\t\toutput := ResultOutput{\n193\t\t\tOutcome: ResultOutcomeAdopted,\n194\t\t\tBranch:  branch,\n195\t\t\tPRURL:   url,\n196\t\t}\n197\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n198\t\tif err != nil {\n199\t\t\tglog.Warningf(\"execution: marshal adopted ## Result failed: %v\", err)\n200\t\t\treturn nil\n201\t\t}\n202\t\tmd.ReplaceSection(section)\n203\t\treturn &agentlib.Result{\n204\t\t\tStatus:    agentlib.AgentStatusDone,\n205\t\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n206\t\t}\n207\t}\n208\t\n209\t// validatePlan extracts and validates the ## Plan section.\n210\tfunc (s *executionStep) validatePlan(\n211\t\tctx context.Context,\n212\t\tmd *agentlib.Markdown,\n213\t) (*PlanOutput, error) {\n214\t\tplan, err := agentlib.ExtractSection[PlanOutput](ctx, md, \"## Plan\")\n215\t\tif err != nil || plan == nil {\n216\t\t\treturn nil, errors.Wrapf(ctx, err, \"execution invoked but planning did not complete\")\n217\t\t}\n218\t\tif plan.Outcome != PlanOutcomeReady || !plan.HasWork {\n219\t\t\treturn nil, errors.Errorf(\n220\t\t\t\tctx,\n221\t\t\t\t\"execution invoked with non-ready plan: outcome=%s has_work=%t\",\n222\t\t\t\tplan.Outcome, plan.HasWork,\n223\t\t\t)\n224\t\t}\n225\t\tif len(plan.GateTargets) == 0 {\n226\t\t\treturn nil, errors.Errorf(ctx, \"execution invoked with empty gate_targets\")\n227\t\t}\n228\t\treturn plan, nil\n229\t}\n230\t\n231\t// extractFrontmatter reads the required frontmatter fields.\n232\tfunc (s *executionStep) extractFrontmatter(\n233\t\tctx context.Context,\n234\t\tmd *agentlib.Markdown,\n235\t) (repo, cloneURL, ref string, _ error) {\n236\t\trepo, _ = md.Frontmatter.String(\"repo\")\n237\t\tcloneURL, _ = md.Frontmatter.String(\"clone_url\")\n238\t\tref, _ = md.Frontmatter.String(\"ref\")\n239\t\tif repo == \"\" || cloneURL == \"\" || ref == \"\" {\n240\t\t\treturn \"\", \"\", \"\", errors.Errorf(\n241\t\t\t\tctx,\n242\t\t\t\t\"missing frontmatter: repo=%q clone_url=%q ref=%q\",\n243\t\t\t\trepo, cloneURL, ref,\n244\t\t\t)\n245\t\t}\n246\t\tif len(ref) < 7 {\n247\t\t\treturn \"\", \"\", \"\", errors.Errorf(ctx, \"frontmatter ref too short for branch name: %q\", ref)\n248\t\t}\n249\t\treturn repo, cloneURL, ref, nil\n250\t}\n251\t\n252\t// runUpdate issues the workdir-scoped Claude sub-call (update sequence +\n253\t// repair-to-green + CHANGELOG bullet). The sub-call has NO git and NO gh\n254\t// tools — its tool scope is file-edit + go/make only.\n255\tfunc (s *executionStep) runUpdate(\n256\t\tctx context.Context,\n257\t\tworkdir string,\n258\t\tplan *PlanOutput,\n259\t) (*executionReport, error) {\n260\t\tplanJSON, err := agentlib.MarshalSectionTyped(ctx, \"## Plan\", *plan)\n261\t\tif err != nil {\n262\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal plan for prompt\")\n263\t\t}\n264\t\tprompt := prompts.ExecutionPrompt() +\n265\t\t\t\"\\n\\n## Workdir\\n\\n\" + workdir +\n266\t\t\t\"\\n\\n## Target Go\\n\\n\" + targetGoVersion() +\n267\t\t\t\"\\n\\n\" + planJSON.Heading + \"\\n\\n\" + planJSON.Body\n268\t\trunResult, err := s.runner.Run(ctx, prompt)\n269\t\tif err != nil {\n270\t\t\treturn nil, errors.Wrap(ctx, err, \"claude execution run\")\n271\t\t}\n272\t\treport, perr := parseJSONResponse[executionReport](ctx, runResult.Result)\n273\t\tif perr != nil {\n274\t\t\t// Best-effort metadata — the deterministic gate re-run below is the\n275\t\t\t// actual verdict; do not fail the pipeline over report formatting.\n276\t\t\tglog.Warningf(\"execution: parse claude report failed (continuing): %v\", perr)\n277\t\t\treturn &executionReport{}, nil\n278\t\t}\n279\t\treturn report, nil\n280\t}\n281\t\n282\t// rerunGates re-runs every planned gate target deterministically. Returns a\n283\t// non-nil failResult when a target stays red (design: Status Failed with the\n284\t// failing target + output tail in Message; resume cursor = execution).\n285\tfunc (s *executionStep) rerunGates(\n286\t\tctx context.Context,\n287\t\tmd *agentlib.Markdown,\n288\t\tworkdir string,\n289\t\tplan *PlanOutput,\n290\t\tresult *ResultOutput,\n291\t\treport *executionReport,\n292\t) (*agentlib.Result, error) {\n293\t\tfor _, target := range plan.GateTargets {\n294\t\t\ttail, exitCode, err := s.gate.RunTarget(ctx, workdir, target)\n295\t\t\tif err != nil {\n296\t\t\t\tresult.GateExit = exitCode\n297\t\t\t\tresult.FailedTarget = target\n298\t\t\t\tmsg := fmt.Sprintf(\"gate target %q failed (exit %d): %s\", target, exitCode, tail)\n299\t\t\t\tif report.Blocked != \"\" {\n300\t\t\t\t\tmsg += \" — claude reported blocked: \" + report.Blocked\n301\t\t\t\t}\n302\t\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, errors.Errorf(ctx, \"%s\", msg))\n303\t\t\t}\n304\t\t}\n305\t\tresult.GateExit = 0\n306\t\treturn nil, nil\n307\t}\n308\t\n309\t// commitPushAndOpenPR runs the no-effective-change guard, then the guarded\n310\t// commit → push → draft-PR tail, and writes the successful ## Result.\n311\tfunc (s *executionStep) commitPushAndOpenPR(\n312\t\tctx context.Context,\n313\t\tmd *agentlib.Markdown,\n314\t\tworkdir, branch string,\n315\t\tplan *PlanOutput,\n316\t\treport *executionReport,\n317\t\tresult *ResultOutput,\n318\t) (*agentlib.Result, error) {\n319\t\tchanged, err := s.ops.ChangedFiles(ctx, workdir)\n320\t\tif err != nil {\n321\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n322\t\t}\n323\t\tif isNoEffectiveChange(changed) {\n324\t\t\treturn s.noEffectiveChange(ctx, md, changed)\n325\t\t}\n326\t\tif offending := workflowPaths(changed); len(offending) > 0 {\n327\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnexpectedDiff,\n328\t\t\t\terrors.Errorf(ctx,\n329\t\t\t\t\t\"update touched forbidden workflow paths %v — refusing to commit\", offending))\n330\t\t}\n331\t\n332\t\tif _, err := s.ops.Commit(ctx, workdir, prTitle, changed...); err != nil {\n333\t\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n334\t\t}\n335\t\n336\t\t// Post-commit guard (belt + suspenders): the release trust model depends\n337\t\t// on the commit containing only the guarded change set.\n338\t\tcommitted, err := s.ops.CommittedFiles(ctx, workdir)\n339\t\tif err != nil {\n340\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n341\t\t}\n342\t\tif offending := workflowPaths(committed); len(offending) > 0 {\n343\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnexpectedDiff,\n344\t\t\t\terrors.Errorf(ctx,\n345\t\t\t\t\t\"commit contains forbidden workflow paths %v — refusing to push\", offending))\n346\t\t}\n347\t\n348\t\tif err := s.ops.Push(ctx, workdir, branch); err != nil {\n349\t\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n350\t\t}\n351\t\n352\t\tvulnsFixed := intersectFixVulns(plan, report)\n353\t\tprURL, err := s.gh.CreateDraftPR(\n354\t\t\tctx, workdir, \"master\", branch, prTitle,\n355\t\t\tbuildPRBody(plan, report, vulnsFixed),\n356\t\t)\n357\t\tif err != nil {\n358\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n359\t\t}\n360\t\n361\t\tresult.Outcome = ResultOutcomeOpened\n362\t\tresult.PRURL = prURL\n363\t\tresult.DepsUpdated = report.DepsUpdated\n364\t\tresult.VulnsFixed = vulnsFixed\n365\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", *result)\n366\t\tif err != nil {\n367\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section\")\n368\t\t}\n369\t\tmd.ReplaceSection(section)\n370\t\n371\t\tglog.V(2).Infof(\"execution: draft PR opened %s branch=%s\", prURL, branch)\n372\t\treturn &agentlib.Result{\n373\t\t\tStatus:    agentlib.AgentStatusDone,\n374\t\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n375\t\t}, nil\n376\t}\n377\t\n378\t// noEffectiveChange writes ## Result(outcome=no_update_needed) and routes to\n379\t// done — the same terminal-success shape planning's own no-op path uses\n380\t// (design guard for the go-skeleton PR #51 incident: planning's go-list scan\n381\t// can classify has_work=true on stale INDIRECT deps that go get -u ./... +\n382\t// go mod tidy no-op under MVS resolution; the only diff left in that run was\n383\t// the CHANGELOG bullet Claude wrote describing dependency updates that don't\n384\t// exist). Nothing is committed, pushed, or opened as a PR — the workdir\n385\t// (and any CHANGELOG-only edit in it) is simply discarded by the caller's\n386\t// deferred cleanup.\n387\tfunc (s *executionStep) noEffectiveChange(\n388\t\tctx context.Context,\n389\t\tmd *agentlib.Markdown,\n390\t\tchanged []string,\n391\t) (*agentlib.Result, error) {\n392\t\tglog.V(2).Infof(\n393\t\t\t\"execution: no effective change after claude sub-call (changed=%v) — discarding workdir\",\n394\t\t\tchanged,\n395\t\t)\n396\t\toutput := ResultOutput{Outcome: ResultOutcomeNoUpdateNeeded}\n397\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n398\t\tif err != nil {\n399\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section (no_update_needed)\")\n400\t\t}\n401\t\tmd.ReplaceSection(section)\n402\t\treturn &agentlib.Result{\n403\t\t\tStatus:    agentlib.AgentStatusDone,\n404\t\t\tNextPhase: domain.TaskPhaseDone.String(),\n405\t\t}, nil\n406\t}\n407\t\n408\t// fail writes a ## Result(outcome=failed) section with the supplied\n409\t// error_category + redacted error string, and returns Status=Failed for\n410\t// controller retry (resume cursor = execution; the step never writes\n411\t// ## Failure, never mutates assignee/status, never routes human_review).\n412\tfunc (s *executionStep) fail(\n413\t\tctx context.Context,\n414\t\tmd *agentlib.Markdown,\n415\t\tresult *ResultOutput,\n416\t\tcategory git.ErrorCategory,\n417\t\tcause error,\n418\t) (*agentlib.Result, error) {\n419\t\tmsg := \"\"\n420\t\tif cause != nil {\n421\t\t\tmsg = git.RedactToken(cause.Error())\n422\t\t}\n423\t\toutput := *result\n424\t\toutput.Outcome = ResultOutcomeFailed\n425\t\toutput.ErrorCategory = category\n426\t\toutput.Error = msg\n427\t\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n428\t\tif err != nil {\n429\t\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section (failed)\")\n430\t\t}\n431\t\tmd.ReplaceSection(section)\n432\t\tglog.V(2).Infof(\"execution failed: category=%s err=%s\", category, msg)\n433\t\treturn &agentlib.Result{\n434\t\t\tStatus:  agentlib.AgentStatusFailed,\n435\t\t\tMessage: msg,\n436\t\t}, nil\n437\t}\n438\t\n439\t// isNoEffectiveChange reports whether changed is empty or a subset of\n440\t// {CHANGELOG.md} — i.e. go get -u ./... + go mod tidy produced nothing under\n441\t// MVS resolution and the only diff left is the CHANGELOG bullet the Claude\n442\t// sub-call writes to describe the (nonexistent) update. This is the\n443\t// go-skeleton PR #51 guard: a plan that classified has_work=true off\n444\t// go-list's INDIRECT-deps view must not turn into a draft PR containing only\n445\t// a fabricated CHANGELOG entry.\n446\tfunc isNoEffectiveChange(changed []string) bool {\n447\t\tfor _, p := range changed {\n448\t\t\tif p != changelogFileName {\n449\t\t\t\treturn false\n450\t\t\t}\n451\t\t}\n452\t\treturn true\n453\t}\n454\t\n455\t// workflowPaths returns the paths under .github/workflows/ (forbidden set).\n456\tfunc workflowPaths(paths []string) []string {\n457\t\tvar offending []string\n458\t\tfor _, p := range paths {\n459\t\t\tif strings.HasPrefix(p, workflowsPrefix) {\n460\t\t\t\toffending = append(offending, p)\n461\t\t\t}\n462\t\t}\n463\t\treturn offending\n464\t}\n465\t\n466\t// intersectFixVulns enforces the design § 4.4 invariant\n467\t// Result.vulns_fixed ⊆ {v.id | v ∈ Plan.vulns, action=fix}. When the Claude\n468\t// report carried IDs, they are filtered against the plan's fix set; when the\n469\t// report was empty/unparseable, the plan's full fix set is used — justified\n470\t// because the deterministic green gate proves the scanners are clean.\n471\tfunc intersectFixVulns(plan *PlanOutput, report *executionReport) []string {\n472\t\tfixSet := map[string]struct{}{}\n473\t\tvar planFix []string\n474\t\tfor _, v := range plan.Vulns {\n475\t\t\tif v.Action == VulnActionFix {\n476\t\t\t\tfixSet[v.ID] = struct{}{}\n477\t\t\t\tplanFix = append(planFix, v.ID)\n478\t\t\t}\n479\t\t}\n480\t\tif len(report.VulnsFixed) == 0 {\n481\t\t\treturn planFix\n482\t\t}\n483\t\tvar out []string\n484\t\tfor _, id := range report.VulnsFixed {\n485\t\t\tif _, ok := fixSet[id]; ok {\n486\t\t\t\tout = append(out, id)\n487\t\t\t}\n488\t\t}\n489\t\treturn out\n490\t}\n491\t\n492\t// buildPRBody assembles the informative draft-PR body: what changed, the\n493\t// green gate evidence, and the release-agent handoff note. No secrets, no\n494\t// attribution.\n495\tfunc buildPRBody(plan *PlanOutput, report *executionReport, vulnsFixed []string) string {\n496\t\tvar b strings.Builder\n497\t\tb.WriteString(\"Automated Go toolchain + dependency update.\\n\\n\")\n498\t\tif plan.GoBump != nil {\n499\t\t\tfmt.Fprintf(&b, \"- go directive: %s -> %s\\n\", plan.GoBump.From, plan.GoBump.To)\n500\t\t}\n501\t\tif report.DepsUpdated > 0 {\n502\t\t\tfmt.Fprintf(&b, \"- dependencies updated: %d\\n\", report.DepsUpdated)\n503\t\t}\n504\t\tif len(vulnsFixed) > 0 {\n505\t\t\tfmt.Fprintf(&b, \"- vulnerabilities fixed: %s\\n\", strings.Join(vulnsFixed, \", \"))\n506\t\t}\n507\t\tfmt.Fprintf(&b, \"- gate green: %s (exit 0)\\n\", strings.Join(plan.GateTargets, \", \"))\n508\t\tif report.Notes != \"\" {\n509\t\t\tfmt.Fprintf(&b, \"- notes: %s\\n\", report.Notes)\n510\t\t}\n511\t\tb.WriteString(\n512\t\t\t\"\\nCHANGELOG entry stays under `## Unreleased` — the release agent versions and tags on merge.\\n\",\n513\t\t)\n514\t\treturn b.String()\n515\t}\n516\t"}]},"parent_tool_use_id":null,"session_id":"ef341d7c-598a-44a9-af65-46186c69de29","uuid":"cb475fc0-93dd-49e4-9193-25c548e4d8fe","timestamp":"2026-08-15T08:25:38.741Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/steps_execution.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\npackage pkg\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\tclaudelib \"github.com/bborbe/agent/claude\"\n\t\"github.com/bborbe/errors\"\n\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n\t\"github.com/golang/glog\"\n\n\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n\t\"github.com/bborbe/github-update-go-agent/pkg/prompts\"\n)\n\n// branchPrefix is the deterministic work-branch prefix; the full branch is\n// branchPrefix + ref[:7]. Determinism is the crash-window replay guard: a\n// replayed task computes the same branch and adopts the existing PR instead\n// of pushing a duplicate (design § 5.3).\nconst branchPrefix = \"fix/update-go-\"\n\n// prTitle is the fixed draft-PR title (Stage-1 contract).\nconst prTitle = \"update go module dependencies\"\n\n// workflowsPrefix is the forbidden commit path. The committed-files guard\n// rejects it before push AND the GitHub App lacks the Workflows permission\n// (design D3) — belt + suspenders.\nconst workflowsPrefix = \".github/workflows/\"\n\n// executionReport is the small JSON the execution Claude sub-call returns:\n// metadata about what it changed. Best-effort — the deterministic gate\n// re-run is the actual verdict.\ntype executionReport struct {\n\tDepsUpdated int      `json:\"deps_updated\"`\n\tVulnsFixed  []string `json:\"vulns_fixed\"`\n\tNotes       string   `json:\"notes\"`\n\tBlocked     string   `json:\"blocked\"`\n}\n\n// executionStep implements agentlib.Step for the execution phase: a custom\n// Go step embedding one Claude sub-call. All git/gh side effects are the Go\n// step's — the Claude sub-call has NO git and NO gh tools (design § 7.0).\ntype executionStep struct {\n\trunner  claudelib.ClaudeRunner\n\tops     git.GitOps\n\tgh      GhCli\n\tgate    GateRunner\n\tghToken string\n}\n\n// NewExecutionStep wires the execution step with its four seams: the Claude\n// runner (update + repair sub-call), the GitOps seam (clone/branch/commit/\n// push), the gh CLI seam (draft PR create + adopt), and the gate runner\n// (deterministic green-gate re-run).\nfunc NewExecutionStep(\n\trunner claudelib.ClaudeRunner,\n\tops git.GitOps,\n\tgh GhCli,\n\tgate GateRunner,\n\tghToken string,\n) agentlib.Step {\n\treturn &executionStep{runner: runner, ops: ops, gh: gh, gate: gate, ghToken: ghToken}\n}\n\n// Name implements agentlib.Step.\nfunc (s *executionStep) Name() string { return \"github-update-go-execute\" }\n\n// ShouldRun always returns true; the replay guard lives inside Run\n// (dark-factory pattern) so a crash-window replay can re-route without\n// redoing side effects.\nfunc (s *executionStep) ShouldRun(_ context.Context, _ *agentlib.Markdown) (bool, error) {\n\treturn true, nil\n}\n\n// Run executes the update pipeline:\n//  1. Replay guard — existing successful ## Result → re-route to ai_review.\n//  2. Read ## Plan (must be ready + has_work) + frontmatter.\n//  3. PR-adopt guard — open PR for the deterministic branch → adopt, write\n//     ## Result, re-route (crash-window idempotency, design § 5.3).\n//  4. CloneAtRef + SwitchNewBranch fix/update-go-<ref:7>.\n//  5. Claude sub-call (file-edit + go/make only) — update + repair + CHANGELOG.\n//  6. Deterministic gate re-run of the plan's gate targets → red = Failed\n//     with the failing target + output tail.\n//  7. No-effective-change guard — changed files empty or ⊆ {CHANGELOG.md}\n//     (MVS no-op despite planning's has_work=true) → ## Result\n//     outcome=no_update_needed, Done/NextPhase done, workdir discarded; no\n//     commit/push/PR (go-skeleton PR #51 guard).\n//  8. Changed/committed-files guard — reject .github/workflows/** edits.\n//  9. Commit (explicit pathspec, bot identity) + Push (--no-follow-tags) +\n//     gh pr create --draft.\n//  10. ## Result → Done / NextPhase ai_review.\nfunc (s *executionStep) Run(ctx context.Context, md *agentlib.Markdown) (*agentlib.Result, error) {\n\tif reroute := s.replayGuard(ctx, md); reroute != nil {\n\t\treturn reroute, nil\n\t}\n\n\tplan, err := s.validatePlan(ctx, md)\n\tif err != nil {\n\t\treturn s.fail(ctx, md, &ResultOutput{}, git.ErrorCategoryUnknown, err)\n\t}\n\n\trepo, cloneURL, ref, err := s.extractFrontmatter(ctx, md)\n\tif err != nil {\n\t\treturn s.fail(ctx, md, &ResultOutput{}, git.ErrorCategoryUnknown, err)\n\t}\n\tbranch := branchPrefix + ref[:7]\n\n\tif adopt := s.adoptExistingPR(ctx, md, repo, branch); adopt != nil {\n\t\treturn adopt, nil\n\t}\n\n\tworkdir := setupWorkdir(md, repo)\n\tdefer func() {\n\t\tif err := os.RemoveAll(workdir); err != nil {\n\t\t\tglog.Warningf(\"execution: workdir cleanup failed: path=%s err=%v\", workdir, err)\n\t\t}\n\t}()\n\n\tresult := &ResultOutput{Branch: branch}\n\tauthedURL := injectToken(normalizeCloneURLToHTTPS(cloneURL), s.ghToken)\n\tif err := s.ops.CloneAtRef(ctx, authedURL, ref, workdir); err != nil {\n\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n\t}\n\tif err := s.ops.SwitchNewBranch(ctx, workdir, branch); err != nil {\n\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n\t}\n\n\treport, claudeErr := s.runUpdate(ctx, workdir, plan)\n\tif claudeErr != nil {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, claudeErr)\n\t}\n\n\tif failResult, err := s.rerunGates(ctx, md, workdir, plan, result, report); failResult != nil ||\n\t\terr != nil {\n\t\treturn failResult, err\n\t}\n\n\treturn s.commitPushAndOpenPR(ctx, md, workdir, branch, plan, report, result)\n}\n\n// replayGuard re-routes when a prior run already produced a successful\n// ## Result — the draft PR exists; redoing clone/push would duplicate work.\n// A failed ## Result does NOT re-route: the phase is the resume cursor and\n// a retry re-runs the pipeline.\nfunc (s *executionStep) replayGuard(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n) *agentlib.Result {\n\tprior, err := agentlib.ExtractSection[ResultOutput](ctx, md, \"## Result\")\n\tif err != nil || prior == nil {\n\t\treturn nil\n\t}\n\tif prior.Outcome != ResultOutcomeOpened && prior.Outcome != ResultOutcomeAdopted {\n\t\treturn nil\n\t}\n\tglog.V(2).Infof(\n\t\t\"execution: replay guard — ## Result already %s (pr=%s), re-routing to ai_review\",\n\t\tprior.Outcome, prior.PRURL,\n\t)\n\treturn &agentlib.Result{\n\t\tStatus:    agentlib.AgentStatusDone,\n\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n\t}\n}\n\n// adoptExistingPR is the crash-window guard: the branch name is\n// deterministic, so if an open PR for it already exists (a prior run pushed\n// + created the PR but crashed before ## Result landed), adopt it instead of\n// re-pushing. Errors are logged and ignored — the subsequent push would\n// surface a real problem loudly.\nfunc (s *executionStep) adoptExistingPR(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\trepo, branch string,\n) *agentlib.Result {\n\turl, err := s.gh.FindOpenPRByHead(ctx, repo, branch)\n\tif err != nil {\n\t\tglog.Warningf(\"execution: pr-adopt lookup failed (continuing): %v\", err)\n\t\treturn nil\n\t}\n\tif url == \"\" {\n\t\treturn nil\n\t}\n\tglog.V(2).Infof(\"execution: adopting existing PR %s for branch %s\", url, branch)\n\toutput := ResultOutput{\n\t\tOutcome: ResultOutcomeAdopted,\n\t\tBranch:  branch,\n\t\tPRURL:   url,\n\t}\n\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n\tif err != nil {\n\t\tglog.Warningf(\"execution: marshal adopted ## Result failed: %v\", err)\n\t\treturn nil\n\t}\n\tmd.ReplaceSection(section)\n\treturn &agentlib.Result{\n\t\tStatus:    agentlib.AgentStatusDone,\n\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n\t}\n}\n\n// validatePlan extracts and validates the ## Plan section.\nfunc (s *executionStep) validatePlan(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n) (*PlanOutput, error) {\n\tplan, err := agentlib.ExtractSection[PlanOutput](ctx, md, \"## Plan\")\n\tif err != nil || plan == nil {\n\t\treturn nil, errors.Wrapf(ctx, err, \"execution invoked but planning did not complete\")\n\t}\n\tif plan.Outcome != PlanOutcomeReady || !plan.HasWork {\n\t\treturn nil, errors.Errorf(\n\t\t\tctx,\n\t\t\t\"execution invoked with non-ready plan: outcome=%s has_work=%t\",\n\t\t\tplan.Outcome, plan.HasWork,\n\t\t)\n\t}\n\tif len(plan.GateTargets) == 0 {\n\t\treturn nil, errors.Errorf(ctx, \"execution invoked with empty gate_targets\")\n\t}\n\treturn plan, nil\n}\n\n// extractFrontmatter reads the required frontmatter fields.\nfunc (s *executionStep) extractFrontmatter(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n) (repo, cloneURL, ref string, _ error) {\n\trepo, _ = md.Frontmatter.String(\"repo\")\n\tcloneURL, _ = md.Frontmatter.String(\"clone_url\")\n\tref, _ = md.Frontmatter.String(\"ref\")\n\tif repo == \"\" || cloneURL == \"\" || ref == \"\" {\n\t\treturn \"\", \"\", \"\", errors.Errorf(\n\t\t\tctx,\n\t\t\t\"missing frontmatter: repo=%q clone_url=%q ref=%q\",\n\t\t\trepo, cloneURL, ref,\n\t\t)\n\t}\n\tif len(ref) < 7 {\n\t\treturn \"\", \"\", \"\", errors.Errorf(ctx, \"frontmatter ref too short for branch name: %q\", ref)\n\t}\n\treturn repo, cloneURL, ref, nil\n}\n\n// runUpdate issues the workdir-scoped Claude sub-call (update sequence +\n// repair-to-green + CHANGELOG bullet). The sub-call has NO git and NO gh\n// tools — its tool scope is file-edit + go/make only.\nfunc (s *executionStep) runUpdate(\n\tctx context.Context,\n\tworkdir string,\n\tplan *PlanOutput,\n) (*executionReport, error) {\n\tplanJSON, err := agentlib.MarshalSectionTyped(ctx, \"## Plan\", *plan)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"marshal plan for prompt\")\n\t}\n\tprompt := prompts.ExecutionPrompt() +\n\t\t\"\\n\\n## Workdir\\n\\n\" + workdir +\n\t\t\"\\n\\n## Target Go\\n\\n\" + targetGoVersion() +\n\t\t\"\\n\\n\" + planJSON.Heading + \"\\n\\n\" + planJSON.Body\n\trunResult, err := s.runner.Run(ctx, prompt)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"claude execution run\")\n\t}\n\treport, perr := parseJSONResponse[executionReport](ctx, runResult.Result)\n\tif perr != nil {\n\t\t// Best-effort metadata — the deterministic gate re-run below is the\n\t\t// actual verdict; do not fail the pipeline over report formatting.\n\t\tglog.Warningf(\"execution: parse claude report failed (continuing): %v\", perr)\n\t\treturn &executionReport{}, nil\n\t}\n\treturn report, nil\n}\n\n// rerunGates re-runs every planned gate target deterministically. Returns a\n// non-nil failResult when a target stays red (design: Status Failed with the\n// failing target + output tail in Message; resume cursor = execution).\nfunc (s *executionStep) rerunGates(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tworkdir string,\n\tplan *PlanOutput,\n\tresult *ResultOutput,\n\treport *executionReport,\n) (*agentlib.Result, error) {\n\tfor _, target := range plan.GateTargets {\n\t\ttail, exitCode, err := s.gate.RunTarget(ctx, workdir, target)\n\t\tif err != nil {\n\t\t\tresult.GateExit = exitCode\n\t\t\tresult.FailedTarget = target\n\t\t\tmsg := fmt.Sprintf(\"gate target %q failed (exit %d): %s\", target, exitCode, tail)\n\t\t\tif report.Blocked != \"\" {\n\t\t\t\tmsg += \" — claude reported blocked: \" + report.Blocked\n\t\t\t}\n\t\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, errors.Errorf(ctx, \"%s\", msg))\n\t\t}\n\t}\n\tresult.GateExit = 0\n\treturn nil, nil\n}\n\n// commitPushAndOpenPR runs the no-effective-change guard, then the guarded\n// commit → push → draft-PR tail, and writes the successful ## Result.\nfunc (s *executionStep) commitPushAndOpenPR(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tworkdir, branch string,\n\tplan *PlanOutput,\n\treport *executionReport,\n\tresult *ResultOutput,\n) (*agentlib.Result, error) {\n\tchanged, err := s.ops.ChangedFiles(ctx, workdir)\n\tif err != nil {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n\t}\n\tif isNoEffectiveChange(changed) {\n\t\treturn s.noEffectiveChange(ctx, md, changed)\n\t}\n\tif offending := workflowPaths(changed); len(offending) > 0 {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnexpectedDiff,\n\t\t\terrors.Errorf(ctx,\n\t\t\t\t\"update touched forbidden workflow paths %v — refusing to commit\", offending))\n\t}\n\n\tif _, err := s.ops.Commit(ctx, workdir, prTitle, changed...); err != nil {\n\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n\t}\n\n\t// Post-commit guard (belt + suspenders): the release trust model depends\n\t// on the commit containing only the guarded change set.\n\tcommitted, err := s.ops.CommittedFiles(ctx, workdir)\n\tif err != nil {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n\t}\n\tif offending := workflowPaths(committed); len(offending) > 0 {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnexpectedDiff,\n\t\t\terrors.Errorf(ctx,\n\t\t\t\t\"commit contains forbidden workflow paths %v — refusing to push\", offending))\n\t}\n\n\tif err := s.ops.Push(ctx, workdir, branch); err != nil {\n\t\treturn s.fail(ctx, md, result, git.ClassifyError(err), err)\n\t}\n\n\tvulnsFixed := intersectFixVulns(plan, report)\n\tprURL, err := s.gh.CreateDraftPR(\n\t\tctx, workdir, \"master\", branch, prTitle,\n\t\tbuildPRBody(plan, report, vulnsFixed),\n\t)\n\tif err != nil {\n\t\treturn s.fail(ctx, md, result, git.ErrorCategoryUnknown, err)\n\t}\n\n\tresult.Outcome = ResultOutcomeOpened\n\tresult.PRURL = prURL\n\tresult.DepsUpdated = report.DepsUpdated\n\tresult.VulnsFixed = vulnsFixed\n\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", *result)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section\")\n\t}\n\tmd.ReplaceSection(section)\n\n\tglog.V(2).Infof(\"execution: draft PR opened %s branch=%s\", prURL, branch)\n\treturn &agentlib.Result{\n\t\tStatus:    agentlib.AgentStatusDone,\n\t\tNextPhase: domain.TaskPhaseAIReview.String(),\n\t}, nil\n}\n\n// noEffectiveChange writes ## Result(outcome=no_update_needed) and routes to\n// done — the same terminal-success shape planning's own no-op path uses\n// (design guard for the go-skeleton PR #51 incident: planning's go-list scan\n// can classify has_work=true on stale INDIRECT deps that go get -u ./... +\n// go mod tidy no-op under MVS resolution; the only diff left in that run was\n// the CHANGELOG bullet Claude wrote describing dependency updates that don't\n// exist). Nothing is committed, pushed, or opened as a PR — the workdir\n// (and any CHANGELOG-only edit in it) is simply discarded by the caller's\n// deferred cleanup.\nfunc (s *executionStep) noEffectiveChange(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tchanged []string,\n) (*agentlib.Result, error) {\n\tglog.V(2).Infof(\n\t\t\"execution: no effective change after claude sub-call (changed=%v) — discarding workdir\",\n\t\tchanged,\n\t)\n\toutput := ResultOutput{Outcome: ResultOutcomeNoUpdateNeeded}\n\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section (no_update_needed)\")\n\t}\n\tmd.ReplaceSection(section)\n\treturn &agentlib.Result{\n\t\tStatus:    agentlib.AgentStatusDone,\n\t\tNextPhase: domain.TaskPhaseDone.String(),\n\t}, nil\n}\n\n// fail writes a ## Result(outcome=failed) section with the supplied\n// error_category + redacted error string, and returns Status=Failed for\n// controller retry (resume cursor = execution; the step never writes\n// ## Failure, never mutates assignee/status, never routes human_review).\nfunc (s *executionStep) fail(\n\tctx context.Context,\n\tmd *agentlib.Markdown,\n\tresult *ResultOutput,\n\tcategory git.ErrorCategory,\n\tcause error,\n) (*agentlib.Result, error) {\n\tmsg := \"\"\n\tif cause != nil {\n\t\tmsg = git.RedactToken(cause.Error())\n\t}\n\toutput := *result\n\toutput.Outcome = ResultOutcomeFailed\n\toutput.ErrorCategory = category\n\toutput.Error = msg\n\tsection, err := agentlib.MarshalSectionTyped(ctx, \"## Result\", output)\n\tif err != nil {\n\t\treturn nil, errors.Wrap(ctx, err, \"marshal ## Result section (failed)\")\n\t}\n\tmd.ReplaceSection(section)\n\tglog.V(2).Infof(\"execution failed: category=%s err=%s\", category, msg)\n\treturn &agentlib.Result{\n\t\tStatus:  agentlib.AgentStatusFailed,\n\t\tMessage: msg,\n\t}, nil\n}\n\n// isNoEffectiveChange reports whether changed is empty or a subset of\n// {CHANGELOG.md} — i.e. go get -u ./... + go mod tidy produced nothing under\n// MVS resolution and the only diff left is the CHANGELOG bullet the Claude\n// sub-call writes to describe the (nonexistent) update. This is the\n// go-skeleton PR #51 guard: a plan that classified has_work=true off\n// go-list's INDIRECT-deps view must not turn into a draft PR containing only\n// a fabricated CHANGELOG entry.\nfunc isNoEffectiveChange(changed []string) bool {\n\tfor _, p := range changed {\n\t\tif p != changelogFileName {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// workflowPaths returns the paths under .github/workflows/ (forbidden set).\nfunc workflowPaths(paths []string) []string {\n\tvar offending []string\n\tfor _, p := range paths {\n\t\tif strings.HasPrefix(p, workflowsPrefix) {\n\t\t\toffending = append(offending, p)\n\t\t}\n\t}\n\treturn offending\n}\n\n// intersectFixVulns enforces the design § 4.4 invariant\n// Result.vulns_fixed ⊆ {v.id | v ∈ Plan.vulns, action=fix}. When the Claude\n// report carried IDs, they are filtered against the plan's fix set; when the\n// report was empty/unparseable, the plan's full fix set is used — justified\n// because the deterministic green gate proves the scanners are clean.\nfunc intersectFixVulns(plan *PlanOutput, report *executionReport) []string {\n\tfixSet := map[string]struct{}{}\n\tvar planFix []string\n\tfor _, v := range plan.Vulns {\n\t\tif v.Action == VulnActionFix {\n\t\t\tfixSet[v.ID] = struct{}{}\n\t\t\tplanFix = append(planFix, v.ID)\n\t\t}\n\t}\n\tif len(report.VulnsFixed) == 0 {\n\t\treturn planFix\n\t}\n\tvar out []string\n\tfor _, id := range report.VulnsFixed {\n\t\tif _, ok := fixSet[id]; ok {\n\t\t\tout = append(out, id)\n\t\t}\n\t}\n\treturn out\n}\n\n// buildPRBody assembles the informative draft-PR body: what changed, the\n// green gate evidence, and the release-agent handoff note. No secrets, no\n// attribution.\nfunc buildPRBody(plan *PlanOutput, report *executionReport, vulnsFixed []string) string {\n\tvar b strings.Builder\n\tb.WriteString(\"Automated Go toolchain + dependency update.\\n\\n\")\n\tif plan.GoBump != nil {\n\t\tfmt.Fprintf(&b, \"- go directive: %s -> %s\\n\", plan.GoBump.From, plan.GoBump.To)\n\t}\n\tif report.DepsUpdated > 0 {\n\t\tfmt.Fprintf(&b, \"- dependencies updated: %d\\n\", report.DepsUpdated)\n\t}\n\tif len(vulnsFixed) > 0 {\n\t\tfmt.Fprintf(&b, \"- vulnerabilities fixed: %s\\n\", strings.Join(vulnsFixed, \", \"))\n\t}\n\tfmt.Fprintf(&b, \"- gate green: %s (exit 0)\\n\", strings.Join(plan.GateTargets, \", \"))\n\tif report.Notes != \"\" {\n\t\tfmt.Fprintf(&b, \"- notes: %s\\n\", report.Notes)\n\t}\n\tb.WriteString(\n\t\t\"\\nCHANGELOG entry stays under `## Unreleased` — the release agent versions and tags on merge.\\n\",\n\t)\n\treturn b.String()\n}\n","numLines":516,"startLine":1,"totalLines":516}}}
