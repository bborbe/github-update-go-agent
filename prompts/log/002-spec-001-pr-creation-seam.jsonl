hCli {\n45\t\treturn &osExecGhCli{ghToken: ghToken}\n46\t}\n47\t\n48\ttype osExecGhCli struct {\n49\t\tghToken string\n50\t}\n51\t\n52\t// cmdEnv returns the env allowlist for gh subprocesses. gh needs HOME to\n53\t// locate ~/.config/gh and PATH to resolve git; GH_TOKEN carries the\n54\t// credential. Strict allowlist prevents pod-level secrets from leaking.\n55\tfunc (g *osExecGhCli) cmdEnv() []string {\n56\t\tenv := []string{\n57\t\t\t\"HOME=\" + os.Getenv(\"HOME\"),\n58\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n59\t\t}\n60\t\tif g.ghToken != \"\" {\n61\t\t\tenv = append(env, \"GH_TOKEN=\"+g.ghToken)\n62\t\t}\n63\t\treturn env\n64\t}\n65\t\n66\tfunc (g *osExecGhCli) CreateDraftPR(\n67\t\tctx context.Context,\n68\t\tworkdir, base, head, title, body string,\n69\t) (string, error) {\n70\t\t// gh pr create --draft --base <base> --head <head> --title <title> --body <body>\n71\t\t// --draft is hardcoded: the agent opens drafts only; the human promotes.\n72\t\t// #nosec G204 -- binary is hardcoded gh; workdir is os.TempDir-rooted; head is the deterministic branch name\n73\t\tcmd := exec.CommandContext(\n74\t\t\tctx,\n75\t\t\t\"gh\", \"pr\", \"create\",\n76\t\t\t\"--draft\",\n77\t\t\t\"--base\", base,\n78\t\t\t\"--head\", head,\n79\t\t\t\"--title\", title,\n80\t\t\t\"--body\", body,\n81\t\t)\n82\t\tcmd.Dir = workdir\n83\t\tcmd.Env = g.cmdEnv()\n84\t\tout, err := cmd.CombinedOutput()\n85\t\tif err != nil {\n86\t\t\treturn \"\", errors.Errorf(\n87\t\t\t\tctx,\n88\t\t\t\t\"gh pr create --draft: %s\",\n89\t\t\t\tstrings.TrimSpace(string(out)),\n90\t\t\t)\n91\t\t}\n92\t\t// gh prints the PR URL as the last non-empty stdout line.\n93\t\turl := lastNonEmptyLine(string(out))\n94\t\tglog.V(2).Infof(\"gh pr create --draft succeeded: url=%s head=%s\", url, head)\n95\t\treturn url, nil\n96\t}\n97\t\n98\tfunc (g *osExecGhCli) FindOpenPRByHead(\n99\t\tctx context.Context,\n100\t\trepo, head string,\n101\t) (string, error) {\n102\t\t// gh pr list --repo <repo> --head <head> --state open -