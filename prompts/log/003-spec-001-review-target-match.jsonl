{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_function_sfnegq3hgmqg_3","type":"tool_result","content":"1\t// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n2\t// Use of this source code is governed by a BSD-style\n3\t// license that can be found in the LICENSE file.\n4\t\n5\t// Package factory wires concrete dependencies for the github-update-go-agent binary.\n6\t//\n7\t// All factory functions follow the Create* prefix convention and contain\n8\t// zero business logic — they compose constructors with config.\n9\tpackage factory\n10\t\n11\timport (\n12\t\t\"context\"\n13\t\n14\t\tagentlib \"github.com/bborbe/agent\"\n15\t\tclaudelib \"github.com/bborbe/agent/claude\"\n16\t\tdelivery \"github.com/bborbe/agent/delivery\"\n17\t\thealthcheck \"github.com/bborbe/agent/healthcheck\"\n18\t\t\"github.com/bborbe/cqrs/base\"\n19\t\tlibkafka \"github.com/bborbe/kafka\"\n20\t\tlibtime \"github.com/bborbe/time\"\n21\t\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n22\t\n23\t\tupdatepkg \"github.com/bborbe/github-update-go-agent/pkg\"\n24\t\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n25\t)\n26\t\n27\tconst serviceName = \"github-update-go-agent\"\n28\t\n29\t// taskTypeGithubUpdateGo is the agent-lib TaskType literal for this agent's\n30\t// domain task. No constant exists in agent-lib for this value, so we cast it\n31\t// locally (mirrors github-dark-factory-agent). Keep the literal exactly\n32\t// \"github-update-go\" — the watcher emits it verbatim and the CRD\n33\t// trigger.task_type field must match.\n34\tvar taskTypeGithubUpdateGo = agentlib.TaskType(\"github-update-go\")\n35\t\n36\t// planningTools is the planning phase's Claude tool scope: inspect-only —\n37\t// no Edit/Write, no push (design § 4.3 planning).\n38\tvar planningTools = claudelib.AllowedTools{\n39\t\t\"Read\", \"Grep\", \"Glob\",\n40\t\t\"Bash(git:*)\", \"Bash(go:*)\", \"Bash(make:*)\",\n41\t}\n42\t\n43\t// executionTools is the execution Claude sub-call's tool scope: file-edit +\n44\t// go/make only — NO git, NO gh. Every git/PR side effect is the Go step's\n45\t// (design § 7.0 capability removal).\n46\tvar executionTools = claudelib.AllowedTools{\n47\t\t\"Read\", \"Grep\", \"Glob\", \"Edit\", \"Write\",\n48\t\t\"Bash(go:*)\", \"Bash(make:*)\",\n49\t}\n50\t\n51\t// CreateClaudeRunner constructs a ClaudeRunner pre-configured with tools,\n52\t// model, working directory, and CLI environment.\n53\tfunc CreateClaudeRunner(\n54\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n55\t\tagentDir claudelib.AgentDir,\n56\t\tallowedTools claudelib.AllowedTools,\n57\t\tmodel claudelib.ClaudeModel,\n58\t\tenv map[string]string,\n59\t) claudelib.ClaudeRunner {\n60\t\treturn claudelib.NewClaudeRunner(claudelib.ClaudeRunnerConfig{\n61\t\t\tClaudeConfigDir:  claudeConfigDir,\n62\t\t\tAllowedTools:     allowedTools,\n63\t\t\tModel:            model,\n64\t\t\tWorkingDirectory: agentDir,\n65\t\t\tEnv:              env,\n66\t\t})\n67\t}\n68\t\n69\t// CreateGitOps wires the os/exec GitOps seam.\n70\tfunc CreateGitOps() git.GitOps {\n71\t\treturn git.NewOSExecGitOps()\n72\t}\n73\t\n74\t// CreateGhCli wires the os/exec gh CLI seam with the resolved GitHub token.\n75\tfunc CreateGhCli(ghToken string) updatepkg.GhCli {\n76\t\treturn updatepkg.NewOSExecGhCli(ghToken)\n77\t}\n78\t\n79\t// CreateGateRunner wires the os/exec make gate runner.\n80\tfunc CreateGateRunner() updatepkg.GateRunner {\n81\t\treturn updatepkg.NewOSExecGateRunner()\n82\t}\n83\t\n84\t// CreateClaudeProber wires the claude-auth preflight prober.\n85\tfunc CreateClaudeProber(claudeConfigDir claudelib.ClaudeConfigDir) updatepkg.ClaudeProber {\n86\t\treturn updatepkg.NewClaudeProber(claudeConfigDir)\n87\t}\n88\t\n89\t// CreateSyncProducer creates a Kafka sync producer.\n90\tfunc CreateSyncProducer(\n91\t\tctx context.Context,\n92\t\tbrokers libkafka.Brokers,\n93\t) (libkafka.SyncProducer, error) {\n94\t\treturn libkafka.NewSyncProducerWithName(ctx, brokers, serviceName)\n95\t}\n96\t\n97\t// CreateKafkaResultDeliverer creates a ResultDeliverer that publishes task\n98\t// updates to Kafka via CQRS commands. Uses the passthrough content generator\n99\t// — the agent framework's StepRunner already produces the full marshaled\n100\t// task in result.Output; the deliverer publishes it as-is and overrides\n101\t// status/phase frontmatter based on the result Status.\n102\tfunc CreateKafkaResultDeliverer(\n103\t\tsyncProducer libkafka.SyncProducer,\n104\t\ttopicPrefix base.TopicPrefix,\n105\t\ttaskID agentlib.TaskIdentifier,\n106\t\toriginalContent string,\n107\t\tcurrentDateTime libtime.CurrentDateTimeGetter,\n108\t) agentlib.ResultDeliverer {\n109\t\treturn delivery.NewKafkaResultDeliverer(\n110\t\t\tsyncProducer,\n111\t\t\ttopicPrefix,\n112\t\t\ttaskID,\n113\t\t\toriginalContent,\n114\t\t\tdelivery.NewPassthroughContentGenerator(),\n115\t\t\tcurrentDateTime,\n116\t\t)\n117\t}\n118\t\n119\t// CreateFileResultDeliverer creates a ResultDeliverer that writes the agent's\n120\t// output back to a markdown file (local CLI mode). Uses the passthrough\n121\t// content generator (same rationale as Kafka).\n122\tfunc CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer {\n123\t\treturn delivery.NewFileResultDeliverer(\n124\t\t\tdelivery.NewPassthroughContentGenerator(),\n125\t\t\tfilePath,\n126\t\t)\n127\t}\n128\t\n129\t// CreateAgent assembles the three distinct phases (design § 4.2):\n130\t//\n131\t//   - planning:  claude-auth + gh-token preflights + Claude planning step\n132\t//     (clone @ ref, detect gate targets, classify findings) → ## Plan\n133\t//   - execution: claude-auth preflight + custom Go step embedding the Claude\n134\t//     update sub-call (clone+branch, update+repair, gate verify, commit,\n135\t//     push --no-follow-tags, gh pr create) → ## Result\n136\t//   - ai_review: pure-Go verifier (PR state, fresh-worktree gate re-run,\n137\t//     CHANGELOG, tag audit) → ## Review → human_review\n138\tfunc CreateAgent(\n139\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n140\t\tagentDir claudelib.AgentDir,\n141\t\tmodel claudelib.ClaudeModel,\n142\t\tghToken string,\n143\t\tclaudeEnv map[string]string,\n144\t\tgitOps git.GitOps,\n145\t\tghCli updatepkg.GhCli,\n146\t\tgateRunner updatepkg.GateRunner,\n147\t\tclaudeProber updatepkg.ClaudeProber,\n148\t\tprTarget updatepkg.PRTarget,\n149\t) *agentlib.Agent {\n150\t\tclaudeAuth := updatepkg.NewClaudeAuthStep(claudeProber)\n151\t\tghTokenCheck := updatepkg.NewGHTokenCheckStep(ghToken)\n152\t\tplanningRunner := CreateClaudeRunner(claudeConfigDir, agentDir, planningTools, model, claudeEnv)\n153\t\tplanningStep := updatepkg.NewPlanningStep(\n154\t\t\tplanningRunner,\n155\t\t\tgitOps,\n156\t\t\tghToken,\n157\t\t\tupdatepkg.NewGhInstallationScope(ghToken),\n158\t\t)\n159\t\texecutionRunner := CreateClaudeRunner(\n160\t\t\tclaudeConfigDir,\n161\t\t\tagentDir,\n162\t\t\texecutionTools,\n163\t\t\tmodel,\n164\t\t\tclaudeEnv,\n165\t\t)\n166\t\texecutionStep := updatepkg.NewExecutionStep(\n167\t\t\texecutionRunner,\n168\t\t\tgitOps,\n169\t\t\tghCli,\n170\t\t\tgateRunner,\n171\t\t\tghToken,\n172\t\t\tprTarget,\n173\t\t)\n174\t\treviewStep := updatepkg.NewReviewStep(gitOps, ghCli, gateRunner, ghToken)\n175\t\n176\t\treturn agentlib.NewAgent(\n177\t\t\tagentlib.NewPhase(domain.TaskPhasePlanning, claudeAuth, ghTokenCheck, planningStep),\n178\t\t\tagentlib.NewPhase(domain.TaskPhaseExecution, claudeAuth, executionStep),\n179\t\t\tagentlib.NewPhase(domain.TaskPhaseAIReview, reviewStep),\n180\t\t)\n181\t}\n182\t\n183\t// CreateAgentProvider wires the per-task-type dispatch table.\n184\t//   - task_type: github-update-go → the 3-phase domain agent\n185\t//   - task_type: healthcheck / oauth-probe → shared liveness agent\n186\t//\n187\t// Pure plumbing; no conditional, no error.\n188\tfunc CreateAgentProvider(\n189\t\tclaudeConfigDir claudelib.ClaudeConfigDir,\n190\t\tagentDir claudelib.AgentDir,\n191\t\tmodel claudelib.ClaudeModel,\n192\t\tghToken string,\n193\t\tclaudeEnv map[string]string,\n194\t\tgitOps git.GitOps,\n195\t\tghCli updatepkg.GhCli,\n196\t\tgateRunner updatepkg.GateRunner,\n197\t\tclaudeProber updatepkg.ClaudeProber,\n198\t\tprTarget updatepkg.PRTarget,\n199\t) agentlib.AgentProvider {\n200\t\tdomainAgent := CreateAgent(\n201\t\t\tclaudeConfigDir,\n202\t\t\tagentDir,\n203\t\t\tmodel,\n204\t\t\tghToken,\n205\t\t\tclaudeEnv,\n206\t\t\tgitOps,\n207\t\t\tghCli,\n208\t\t\tgateRunner,\n209\t\t\tclaudeProber,\n210\t\t\tprTarget,\n211\t\t)\n212\t\thealthcheckRunner := CreateClaudeRunner(\n213\t\t\tclaudeConfigDir,\n214\t\t\tagentDir,\n215\t\t\tclaudelib.AllowedTools{},\n216\t\t\tmodel,\n217\t\t\tclaudeEnv,\n218\t\t)\n219\t\tlivenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(healthcheckRunner))\n220\t\treturn agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n221\t\t\ttaskTypeGithubUpdateGo:       domainAgent,\n222\t\t\tagentlib.TaskTypeHealthcheck: livenessAgent,\n223\t\t\tagentlib.TaskTypeOAuthProbe:  livenessAgent,\n224\t\t})\n225\t}\n226\t"}]},"parent_tool_use_id":null,"session_id":"cd491ce5-179c-442b-ad22-708f3e0ad516","uuid":"7ea5df77-f016-465a-a0d4-eef1f7420754","timestamp":"2026-08-15T08:32:51.515Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/pkg/factory/factory.go","content":"// Copyright (c) 2026 Benjamin Borbe All rights reserved.\n// Use of this source code is governed by a BSD-style\n// license that can be found in the LICENSE file.\n\n// Package factory wires concrete dependencies for the github-update-go-agent binary.\n//\n// All factory functions follow the Create* prefix convention and contain\n// zero business logic — they compose constructors with config.\npackage factory\n\nimport (\n\t\"context\"\n\n\tagentlib \"github.com/bborbe/agent\"\n\tclaudelib \"github.com/bborbe/agent/claude\"\n\tdelivery \"github.com/bborbe/agent/delivery\"\n\thealthcheck \"github.com/bborbe/agent/healthcheck\"\n\t\"github.com/bborbe/cqrs/base\"\n\tlibkafka \"github.com/bborbe/kafka\"\n\tlibtime \"github.com/bborbe/time\"\n\tdomain \"github.com/bborbe/vault-cli/pkg/domain\"\n\n\tupdatepkg \"github.com/bborbe/github-update-go-agent/pkg\"\n\t\"github.com/bborbe/github-update-go-agent/pkg/git\"\n)\n\nconst serviceName = \"github-update-go-agent\"\n\n// taskTypeGithubUpdateGo is the agent-lib TaskType literal for this agent's\n// domain task. No constant exists in agent-lib for this value, so we cast it\n// locally (mirrors github-dark-factory-agent). Keep the literal exactly\n// \"github-update-go\" — the watcher emits it verbatim and the CRD\n// trigger.task_type field must match.\nvar taskTypeGithubUpdateGo = agentlib.TaskType(\"github-update-go\")\n\n// planningTools is the planning phase's Claude tool scope: inspect-only —\n// no Edit/Write, no push (design § 4.3 planning).\nvar planningTools = claudelib.AllowedTools{\n\t\"Read\", \"Grep\", \"Glob\",\n\t\"Bash(git:*)\", \"Bash(go:*)\", \"Bash(make:*)\",\n}\n\n// executionTools is the execution Claude sub-call's tool scope: file-edit +\n// go/make only — NO git, NO gh. Every git/PR side effect is the Go step's\n// (design § 7.0 capability removal).\nvar executionTools = claudelib.AllowedTools{\n\t\"Read\", \"Grep\", \"Glob\", \"Edit\", \"Write\",\n\t\"Bash(go:*)\", \"Bash(make:*)\",\n}\n\n// CreateClaudeRunner constructs a ClaudeRunner pre-configured with tools,\n// model, working directory, and CLI environment.\nfunc CreateClaudeRunner(\n\tclaudeConfigDir claudelib.ClaudeConfigDir,\n\tagentDir claudelib.AgentDir,\n\tallowedTools claudelib.AllowedTools,\n\tmodel claudelib.ClaudeModel,\n\tenv map[string]string,\n) claudelib.ClaudeRunner {\n\treturn claudelib.NewClaudeRunner(claudelib.ClaudeRunnerConfig{\n\t\tClaudeConfigDir:  claudeConfigDir,\n\t\tAllowedTools:     allowedTools,\n\t\tModel:            model,\n\t\tWorkingDirectory: agentDir,\n\t\tEnv:              env,\n\t})\n}\n\n// CreateGitOps wires the os/exec GitOps seam.\nfunc CreateGitOps() git.GitOps {\n\treturn git.NewOSExecGitOps()\n}\n\n// CreateGhCli wires the os/exec gh CLI seam with the resolved GitHub token.\nfunc CreateGhCli(ghToken string) updatepkg.GhCli {\n\treturn updatepkg.NewOSExecGhCli(ghToken)\n}\n\n// CreateGateRunner wires the os/exec make gate runner.\nfunc CreateGateRunner() updatepkg.GateRunner {\n\treturn updatepkg.NewOSExecGateRunner()\n}\n\n// CreateClaudeProber wires the claude-auth preflight prober.\nfunc CreateClaudeProber(claudeConfigDir claudelib.ClaudeConfigDir) updatepkg.ClaudeProber {\n\treturn updatepkg.NewClaudeProber(claudeConfigDir)\n}\n\n// CreateSyncProducer creates a Kafka sync producer.\nfunc CreateSyncProducer(\n\tctx context.Context,\n\tbrokers libkafka.Brokers,\n) (libkafka.SyncProducer, error) {\n\treturn libkafka.NewSyncProducerWithName(ctx, brokers, serviceName)\n}\n\n// CreateKafkaResultDeliverer creates a ResultDeliverer that publishes task\n// updates to Kafka via CQRS commands. Uses the passthrough content generator\n// — the agent framework's StepRunner already produces the full marshaled\n// task in result.Output; the deliverer publishes it as-is and overrides\n// status/phase frontmatter based on the result Status.\nfunc CreateKafkaResultDeliverer(\n\tsyncProducer libkafka.SyncProducer,\n\ttopicPrefix base.TopicPrefix,\n\ttaskID agentlib.TaskIdentifier,\n\toriginalContent string,\n\tcurrentDateTime libtime.CurrentDateTimeGetter,\n) agentlib.ResultDeliverer {\n\treturn delivery.NewKafkaResultDeliverer(\n\t\tsyncProducer,\n\t\ttopicPrefix,\n\t\ttaskID,\n\t\toriginalContent,\n\t\tdelivery.NewPassthroughContentGenerator(),\n\t\tcurrentDateTime,\n\t)\n}\n\n// CreateFileResultDeliverer creates a ResultDeliverer that writes the agent's\n// output back to a markdown file (local CLI mode). Uses the passthrough\n// content generator (same rationale as Kafka).\nfunc CreateFileResultDeliverer(filePath string) agentlib.ResultDeliverer {\n\treturn delivery.NewFileResultDeliverer(\n\t\tdelivery.NewPassthroughContentGenerator(),\n\t\tfilePath,\n\t)\n}\n\n// CreateAgent assembles the three distinct phases (design § 4.2):\n//\n//   - planning:  claude-auth + gh-token preflights + Claude planning step\n//     (clone @ ref, detect gate targets, classify findings) → ## Plan\n//   - execution: claude-auth preflight + custom Go step embedding the Claude\n//     update sub-call (clone+branch, update+repair, gate verify, commit,\n//     push --no-follow-tags, gh pr create) → ## Result\n//   - ai_review: pure-Go verifier (PR state, fresh-worktree gate re-run,\n//     CHANGELOG, tag audit) → ## Review → human_review\nfunc CreateAgent(\n\tclaudeConfigDir claudelib.ClaudeConfigDir,\n\tagentDir claudelib.AgentDir,\n\tmodel claudelib.ClaudeModel,\n\tghToken string,\n\tclaudeEnv map[string]string,\n\tgitOps git.GitOps,\n\tghCli updatepkg.GhCli,\n\tgateRunner updatepkg.GateRunner,\n\tclaudeProber updatepkg.ClaudeProber,\n\tprTarget updatepkg.PRTarget,\n) *agentlib.Agent {\n\tclaudeAuth := updatepkg.NewClaudeAuthStep(claudeProber)\n\tghTokenCheck := updatepkg.NewGHTokenCheckStep(ghToken)\n\tplanningRunner := CreateClaudeRunner(claudeConfigDir, agentDir, planningTools, model, claudeEnv)\n\tplanningStep := updatepkg.NewPlanningStep(\n\t\tplanningRunner,\n\t\tgitOps,\n\t\tghToken,\n\t\tupdatepkg.NewGhInstallationScope(ghToken),\n\t)\n\texecutionRunner := CreateClaudeRunner(\n\t\tclaudeConfigDir,\n\t\tagentDir,\n\t\texecutionTools,\n\t\tmodel,\n\t\tclaudeEnv,\n\t)\n\texecutionStep := updatepkg.NewExecutionStep(\n\t\texecutionRunner,\n\t\tgitOps,\n\t\tghCli,\n\t\tgateRunner,\n\t\tghToken,\n\t\tprTarget,\n\t)\n\treviewStep := updatepkg.NewReviewStep(gitOps, ghCli, gateRunner, ghToken)\n\n\treturn agentlib.NewAgent(\n\t\tagentlib.NewPhase(domain.TaskPhasePlanning, claudeAuth, ghTokenCheck, planningStep),\n\t\tagentlib.NewPhase(domain.TaskPhaseExecution, claudeAuth, executionStep),\n\t\tagentlib.NewPhase(domain.TaskPhaseAIReview, reviewStep),\n\t)\n}\n\n// CreateAgentProvider wires the per-task-type dispatch table.\n//   - task_type: github-update-go → the 3-phase domain agent\n//   - task_type: healthcheck / oauth-probe → shared liveness agent\n//\n// Pure plumbing; no conditional, no error.\nfunc CreateAgentProvider(\n\tclaudeConfigDir claudelib.ClaudeConfigDir,\n\tagentDir claudelib.AgentDir,\n\tmodel claudelib.ClaudeModel,\n\tghToken string,\n\tclaudeEnv map[string]string,\n\tgitOps git.GitOps,\n\tghCli updatepkg.GhCli,\n\tgateRunner updatepkg.GateRunner,\n\tclaudeProber updatepkg.ClaudeProber,\n\tprTarget updatepkg.PRTarget,\n) agentlib.AgentProvider {\n\tdomainAgent := CreateAgent(\n\t\tclaudeConfigDir,\n\t\tagentDir,\n\t\tmodel,\n\t\tghToken,\n\t\tclaudeEnv,\n\t\tgitOps,\n\t\tghCli,\n\t\tgateRunner,\n\t\tclaudeProber,\n\t\tprTarget,\n\t)\n\thealthcheckRunner := CreateClaudeRunner(\n\t\tclaudeConfigDir,\n\t\tagentDir,\n\t\tclaudelib.AllowedTools{},\n\t\tmodel,\n\t\tclaudeEnv,\n\t)\n\tlivenessAgent := healthcheck.NewAgent(healthcheck.NewClaudeStep(healthcheckRunner))\n\treturn agentlib.NewAgentProvider(serviceName, map[agentlib.TaskType]*agentlib.Agent{\n\t\ttaskTypeGithubUpdateGo:       domainAgent,\n\t\tagentlib.TaskTypeHealthcheck: livenessAgent,\n\t\tagentlib.TaskTypeOAuthProbe:  livenessAgent,\n\t})\n}\n","numLines":226,"startLine":1,"totalLines":226}}}
